diff --git a/apps/desktop/tests/wayland-csd.spec.ts b/apps/desktop/tests/wayland-csd.spec.ts
new file mode 100644
index 0000000..b57367d
--- /dev/null
+++ b/apps/desktop/tests/wayland-csd.spec.ts
@@ -0,0 +1,150 @@
+import { EventEmitter } from 'node:events'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  WAYLAND_CSD_ARGUMENT, WAYLAND_CSD_RADIUS, desktopWaylandCsd, markWaylandCsd, onWaylandCsdLayout,
+  waylandClient, waylandCsdFramed, waylandCsdRadius, waylandCsdTiled,
+} from '../src/wayland-csd.ts'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.unstubAllEnvs()
+})
+
+describe('waylandClient', () => {
+  const session = { XDG_SESSION_TYPE: 'wayland', WAYLAND_DISPLAY: 'wayland-0' }
+
+  it('follows the session under the default auto hint', () => {
+    expect(waylandClient([], session)).toBe(true)
+    expect(waylandClient(['--ozone-platform-hint=auto'], session)).toBe(true)
+    expect(waylandClient([], { WAYLAND_DISPLAY: 'wayland-0' })).toBe(true)
+    expect(waylandClient([], { XDG_SESSION_TYPE: 'wayland' })).toBe(true)
+    expect(waylandClient([], { XDG_SESSION_TYPE: 'x11', DISPLAY: ':0' })).toBe(false)
+    expect(waylandClient([], { WAYLAND_DISPLAY: '' })).toBe(false)
+  })
+
+  it('lets an explicit platform override the hint and the session', () => {
+    expect(waylandClient(['--ozone-platform=x11'], session)).toBe(false)
+    expect(waylandClient(['--ozone-platform=x11', '--ozone-platform-hint=wayland'], session)).toBe(false)
+    expect(waylandClient(['--ozone-platform=wayland'], { XDG_SESSION_TYPE: 'x11' })).toBe(true)
+    expect(waylandClient(['--ozone-platform=headless'], session)).toBe(false)
+  })
+
+  it('reads the hint from the switch before the environment', () => {
+    expect(waylandClient(['--ozone-platform-hint=x11'], session)).toBe(false)
+    expect(waylandClient([], { ...session, ELECTRON_OZONE_PLATFORM_HINT: 'x11' })).toBe(false)
+    expect(waylandClient(['--ozone-platform-hint=wayland'], { ELECTRON_OZONE_PLATFORM_HINT: 'x11' })).toBe(true)
+    expect(waylandClient([], { ELECTRON_OZONE_PLATFORM_HINT: 'wayland' })).toBe(true)
+  })
+
+  it('takes the last occurrence and ignores empty values', () => {
+    expect(waylandClient(['--ozone-platform=wayland', '--ozone-platform=x11'], session)).toBe(false)
+    expect(waylandClient(['--ozone-platform='], session)).toBe(true)
+  })
+})
+
+describe('desktopWaylandCsd', () => {
+  it('accepts only the exact value 1 on a linux Wayland client', () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+    vi.stubEnv('XDG_SESSION_TYPE', 'wayland')
+    vi.stubEnv('ELECTRON_OZONE_PLATFORM_HINT', '')
+    for (const value of [undefined, '', '0', 'true', 'yes', '2']) {
+      vi.stubEnv('DSH_DESKTOP_WAYLAND_CSD', value)
+      expect(desktopWaylandCsd()).toBe(false)
+    }
+    vi.stubEnv('DSH_DESKTOP_WAYLAND_CSD', '1')
+    expect(desktopWaylandCsd()).toBe(true)
+    vi.spyOn(process, 'argv', 'get').mockReturnValue(['electron', '--ozone-platform=x11'])
+    expect(desktopWaylandCsd()).toBe(false)
+  })
+
+  it('stays off in an X11 session', () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+    vi.stubEnv('DSH_DESKTOP_WAYLAND_CSD', '1')
+    vi.stubEnv('XDG_SESSION_TYPE', 'x11')
+    vi.stubEnv('WAYLAND_DISPLAY', '')
+    vi.stubEnv('ELECTRON_OZONE_PLATFORM_HINT', '')
+    expect(desktopWaylandCsd()).toBe(false)
+  })
+
+  it.each(['darwin', 'win32'] as const)('stays off on %s even with the variable set', (platform) => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue(platform)
+    vi.stubEnv('DSH_DESKTOP_WAYLAND_CSD', '1')
+    vi.stubEnv('XDG_SESSION_TYPE', 'wayland')
+    expect(desktopWaylandCsd()).toBe(false)
+  })
+
+  it('names the argument the main process hands to the preload', () => {
+    expect(WAYLAND_CSD_ARGUMENT).toBe('--dsh-desktop-wayland-csd')
+  })
+})
+
+describe('frame state', () => {
+  const window = (origin: { x: number; y: number }, maximized = false, fullscreen = false) =>
+    Object.assign(new EventEmitter(), {
+      isMaximized: () => maximized, isFullScreen: () => fullscreen, getContentBounds: () => origin,
+    })
+  const trusted = (origin: { x: number; y: number }, maximized = false, fullscreen = false) => {
+    const framed = window(origin, maximized, fullscreen)
+    markWaylandCsd(framed)
+    framed.emit('move')
+    return framed
+  }
+
+  it('reads a tiled frame from equal frame-sized insets', () => {
+    expect(waylandCsdTiled({ x: 10, y: 10 })).toBe(true)
+    // Floating: the shadow falls downward. Maximized or fullscreen: no frame.
+    expect(waylandCsdTiled({ x: 16, y: 10 })).toBe(false)
+    expect(waylandCsdTiled({ x: 0, y: 0 })).toBe(false)
+    // A requested position before the first configure is not an inset.
+    expect(waylandCsdTiled({ x: 340, y: 340 })).toBe(false)
+    expect(waylandCsdTiled({ x: 24, y: 24 })).toBe(false)
+  })
+
+  it('trusts the origin only after the first move switches it to the frame inset', () => {
+    const requested = window({ x: 10, y: 10 })
+    markWaylandCsd(requested)
+    // Before the first move, an equal, small origin is a requested position, not a tiled frame.
+    expect(waylandCsdRadius(requested)).toBe(8)
+    requested.emit('move')
+    expect(waylandCsdRadius(requested)).toBe(0)
+  })
+
+  it('rounds sibling views only while the frame floats', () => {
+    expect(WAYLAND_CSD_RADIUS).toBe(8)
+    expect(waylandCsdRadius(trusted({ x: 16, y: 10 }))).toBe(8)
+    expect(waylandCsdRadius(trusted({ x: 574, y: 340 }))).toBe(8)
+    expect(waylandCsdRadius(trusted({ x: 10, y: 10 }))).toBe(0)
+    // The maximize event can arrive while the bounds still carry the floating inset.
+    expect(waylandCsdRadius(trusted({ x: 16, y: 10 }, true))).toBe(0)
+    expect(waylandCsdRadius(trusted({ x: 16, y: 10 }, false, true))).toBe(0)
+  })
+
+  it('remembers which windows carry the client frame and consumes its first move', () => {
+    const framed = new EventEmitter()
+    markWaylandCsd(framed)
+    expect(waylandCsdFramed(framed)).toBe(true)
+    expect(framed.eventNames()).toEqual(['move'])
+    framed.emit('move')
+    expect(framed.eventNames()).toEqual([])
+    expect(waylandCsdFramed({})).toBe(false)
+  })
+})
+
+describe('onWaylandCsdLayout', () => {
+  const owner = () => Object.assign(new EventEmitter(), { contentView: new EventEmitter() })
+
+  it('relays every frame-state change until teardown', () => {
+    const window = owner()
+    const relayout = vi.fn()
+    const stop = onWaylandCsdLayout(window, relayout)
+    for (const name of ['move', 'resize', 'maximize', 'unmaximize', 'enter-full-screen', 'leave-full-screen']) window.emit(name)
+    // The root view reports the final bounds after a resize that carried the previous ones.
+    window.contentView.emit('bounds-changed')
+    expect(relayout).toHaveBeenCalledTimes(7)
+    stop()
+    window.emit('move'); window.emit('resize'); window.emit('maximize'); window.contentView.emit('bounds-changed')
+    expect(relayout).toHaveBeenCalledTimes(7)
+    expect(window.eventNames()).toEqual([])
+    expect(window.contentView.eventNames()).toEqual([])
+  })
+})
