new file mode 100644
index 0000000..24c7bd1
--- /dev/null
+++ b/apps/desktop/src/wayland-csd.ts
@@ -0,0 +1,120 @@
+/** Runtime opt-in for a client-drawn Wayland frame around the Linux caption. */
+
+/** Preload argument marking the application document as framed by the Wayland client decoration. */
+export const WAYLAND_CSD_ARGUMENT = '--dsh-desktop-wayland-csd'
+
+/** Corner radius of Chromium's floating client frame; Electron exposes no value for it. */
+export const WAYLAND_CSD_RADIUS = 8
+
+/** A content origin this far in is a requested window position before the first move, not a frame inset. */
+const WAYLAND_CSD_INSET_MAX = 24
+
+const framed = new WeakSet<object>()
+const insetOrigin = new WeakSet<object>()
+
+/**
+ * Whether Electron runs as a Wayland client, resolved in Chromium's order: the platform switch,
+ * then the hint switch or `ELECTRON_OZONE_PLATFORM_HINT`, then the session (the default hint is `auto`).
+ * @param argv - main-process command line.
+ * @param env - main-process environment.
+ * @returns false for an explicit `x11` platform or hint even inside a Wayland session.
+ */
+export function waylandClient(argv: readonly string[], env: NodeJS.ProcessEnv): boolean {
+  const flag = (name: string): string | undefined => {
+    const prefix = `--${name}=`
+    let value: string | undefined
+    for (const argument of argv) if (argument.startsWith(prefix)) value = argument.slice(prefix.length)
+    return value === '' ? undefined : value
+  }
+  const platform = flag('ozone-platform')
+  if (platform !== undefined) return platform === 'wayland'
+  const hint = flag('ozone-platform-hint') ?? env.ELECTRON_OZONE_PLATFORM_HINT
+  if (hint === 'wayland') return true
+  if (hint === 'x11') return false
+  return env.XDG_SESSION_TYPE === 'wayland' || (env.WAYLAND_DISPLAY ?? '') !== ''
+}
+
+/**
+ * Whether the user requested the client-drawn frame: Linux only, only the exact value `1`,
+ * and only as a Wayland client, because X11 has no client frame to draw.
+ * @returns true when the primary window drops server-side decoration for the caption overlay.
+ */
+export function desktopWaylandCsd(): boolean {
+  return process.platform === 'linux' && process.env.DSH_DESKTOP_WAYLAND_CSD === '1'
+    && waylandClient(process.argv, process.env)
+}
+
+/**
+ * Whether the frame is tiled. Wayland reports no window position, so Chromium leaves the frame inset
+ * in the content origin: a floating frame's shadow falls downward (x differs from y), a tiled frame
+ * keeps equal resize borders, and a maximized or fullscreen window has none.
+ * @param origin - `window.getContentBounds()` origin.
+ * @returns true for equal, frame-sized insets.
+ */
+export function waylandCsdTiled(origin: { readonly x: number; readonly y: number }): boolean {
+  return origin.x === origin.y && origin.x > 0 && origin.x < WAYLAND_CSD_INSET_MAX
+}
+
+interface FramedWindow {
+  isMaximized(): boolean
+  isFullScreen(): boolean
+  getContentBounds(): { readonly x: number; readonly y: number }
+}
+
+interface MoveEmitter {
+  once(name: 'move', listener: () => void): unknown
+}
+
+/**
+ * Corner radius a sibling view needs to match the frame, which clips only the window's own web view.
+ * The window APIs report the requested position until the first move and the frame inset afterwards,
+ * so the origin is read only once `markWaylandCsd` has seen that move.
+ * @param window - framed window.
+ * @returns 8 while floating; 0 once the frame drops its corners.
+ */
+export function waylandCsdRadius(window: FramedWindow): number {
+  if (window.isMaximized() || window.isFullScreen()) return 0
+  return insetOrigin.has(window) && waylandCsdTiled(window.getContentBounds()) ? 0 : WAYLAND_CSD_RADIUS
+}
+
+interface LayoutEmitter {
+  on(name: string, listener: () => void): unknown
+  off(name: string, listener: () => void): unknown
+}
+
+/**
+ * Run `relayout` on every frame-state change. The first move switches the window bounds APIs from the
+ * requested position to the frame inset; a resize the application requested can still report the
+ * previous bounds, and the root view's `bounds-changed` then follows with the final ones.
+ * @param window - framed window.
+ * @param relayout - idempotent layout pass.
+ * @returns listener teardown.
+ */
+export function onWaylandCsdLayout(
+  window: LayoutEmitter & { readonly contentView: LayoutEmitter }, relayout: () => void,
+): () => void {
+  // Captured now: teardown can run after the window is destroyed, when its accessors throw.
+  const root = window.contentView
+  const events = ['move', 'resize', 'maximize', 'unmaximize', 'enter-full-screen', 'leave-full-screen'] as const
+  for (const name of events) window.on(name, relayout)
+  root.on('bounds-changed', relayout)
+  return () => {
+    for (const name of events) window.off(name, relayout)
+    root.off('bounds-changed', relayout)
+  }
+}
+
+/**
+ * Remember a window created with the client-drawn frame, and trust its content origin once the first
+ * move has switched the window APIs from the requested position to the frame inset. The listener is
+ * installed at window creation because an overlay can attach after that first move.
+ * @param window - window created with the client-drawn frame.
+ */
+export function markWaylandCsd(window: object & MoveEmitter): void {
+  if (framed.has(window)) return
+  framed.add(window)
+  window.once('move', () => { insetOrigin.add(window) })
+}
+
+/** @param window - any window. @returns Whether it was created with the client-drawn frame. */
+export function waylandCsdFramed(window: object): boolean { return framed.has(window) }
