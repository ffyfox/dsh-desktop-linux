+  // Before the first move, the origin is a requested position, even when it looks like an inset.
+  f.parent.getContentBounds.mockReturnValue({ x: 10, y: 10, width: 900, height: 650 })
+  f.parent.contentView.emit('bounds-changed')
+  expect(view.setBorderRadius).toHaveBeenLastCalledWith(8)
+  // The first move switches both bounds APIs to the frame inset.
+  f.parent.getContentBounds.mockReturnValue({ x: 16, y: 10, width: 900, height: 650 })
+  f.parent.emit('move')
+  expect(view.setBorderRadius).toHaveBeenLastCalledWith(8)
+  // Tiling changes only the frame inset and sends no resize.
+  f.parent.getContentBounds.mockReturnValue({ x: 10, y: 10, width: 900, height: 650 })
+  f.parent.contentView.emit('bounds-changed')
+  expect(view.setBorderRadius).toHaveBeenLastCalledWith(0)
+  f.parent.getContentBounds.mockReturnValue({ x: 16, y: 10, width: 900, height: 650 })
+  f.parent.isMaximized.mockReturnValue(true); f.parent.emit('maximize')
+  expect(view.setBorderRadius).toHaveBeenLastCalledWith(0)
+  f.parent.isMaximized.mockReturnValue(false); f.parent.emit('resize')
+  expect(view.setBorderRadius).toHaveBeenLastCalledWith(8)
+  overlay.destroy()
+  expect(f.parent.eventNames()).toEqual([])
+  expect(f.parent.contentView.eventNames()).toEqual([])
+})
+
+it('trusts the inset origin when the overlay attaches after the first move', () => {
+  vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+  const f = fixture(); markWaylandCsd(f.parent)
+  f.parent.getContentBounds.mockReturnValue({ x: 10, y: 10, width: 900, height: 650 })
+  f.parent.emit('move')
+  const overlay = f.create()
+  expect(f.views[0]!.setBorderRadius).toHaveBeenLastCalledWith(0)
+  overlay.destroy()
+})
