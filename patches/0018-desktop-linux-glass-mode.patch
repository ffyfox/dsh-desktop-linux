new file mode 100644
index 0000000..e1ecf93
--- /dev/null
+++ b/apps/desktop/src/glass-document.ts
@@ -0,0 +1,113 @@
+/**
+ * Glass-mode document injection for the Linux primary window.
+ *
+ * The route — a transparent window whose document carries the glass stylesheet in <head> — follows
+ * the Linux glass patch first published in Mooling0602/nix-packages (`desktop-window-glass.mjs`,
+ * raised in issue #6). Only the route is shared: that patch clears the whole frame and the composer
+ * seat, while this one keeps content, right bar, and bottom row opaque and paints only the sidebar
+ * with upstream's darwin material. The layout work (zero-width collapse, leading seat, clearance)
+ * is this port's own.
+ */
+
+/** Sidebar fill percentages of the macOS material, used when the user sets no tint. */
+const MACOS_LIGHT_TINT = 40
+const MACOS_DARK_TINT = 50
+
+/**
+ * Build the markup injected into the application Web document before its own bundles run: the
+ * `data-dsh-glass` marker, a transparent host document, and the macOS sidebar material copied from
+ * `packages/client/ui-layout/lib/client.js`. Only the sidebar is translucent; content, right bar,
+ * and bottom row keep the theme's opaque fill. The `data-platform=darwin` visual rules stay
+ * unreused (vibrancy material, window drag); the macOS window-chrome geometry — zero-width
+ * collapse, shell.leading seat, sidebar top strip — reaches glass mode through the
+ * `data-platform=linux` branches this port adds to ui-layout and ui-sidebar. The one darwin rule
+ * glass mode does mirror is the hidden list-bottom fade: that gradient ends in the opaque sidebar
+ * fill, which macOS drops over vibrancy and this column drops over its tint.
+ * @param tint - Sidebar fill percentage for both themes, or null for the macOS values.
+ * @returns Markup for the document head.
+ */
+export function glassDocument(tint: number | null): string {
+  const light = tint ?? MACOS_LIGHT_TINT
+  const dark = tint ?? MACOS_DARK_TINT
+  // Reduced transparency must never be clearer than the requested fill.
+  const reduced = Math.max(tint ?? 90, 90)
+  return `<script>document.documentElement.setAttribute('data-dsh-glass','')</script>
+<style>
+/* Transparent host document; content columns below stay opaque. */
+html[data-dsh-glass],
+html[data-dsh-glass] body,
+html[data-dsh-glass] #root {
+  background: transparent !important;
+}
+html[data-dsh-glass] body { isolation: isolate; }
+
+/* The grid frame must not paint the theme background. Match it structurally: every CSS Module in
+   this tree ends in "_frame", so a substring match would also strip the attachment, subagent, and
+   sidebar-browser frames. */
+html[data-dsh-glass] div:has(> [class*="sidebarCol"]) { background: transparent; }
+
+/* Chromium cannot blur a menu over a transparent window: without an opaque backing the menu's
+   translucent fill shows the sidebar text straight through it. macOS ships this backing for the
+   same reason (MenuSurface, darwin only), so glass mode shows it too. */
+html[data-dsh-glass] [data-menu-backing] {
+  display: block;
+  position: fixed;
+  position-anchor: var(--dsh-menu-anchor);
+  top: anchor(top);
+  left: anchor(left);
+  width: anchor-size(width, 0px);
+  height: anchor-size(height, 0px);
+  z-index: -1;
+  background: var(--dsw-alias-bg-base);
+  pointer-events: none;
+}
+
+/* Copied from the macOS sidebar material in ui-layout/lib/client.js. */
+html[data-dsh-glass] [class*="sidebarCol"] {
+  background:
+    linear-gradient(to bottom, #7a9bf01a, #7a9bf000 35%, #8f89b800 68%, #8f89b817),
+    color-mix(in srgb, color-mix(in srgb, var(--dsw-specific-sidebar-fill) 97%, #7a9bf0) ${light}%, transparent);
+  border-right: none;
+}
+html[data-dsh-glass] body[data-ds-dark-theme] [class*="sidebarCol"] {
+  background:
+    linear-gradient(to bottom, #7a9bf014, #7a9bf000 35%, #8f89b800 68%, #8f89b812),
+    color-mix(in srgb, var(--dsw-specific-sidebar-fill) ${dark}%, transparent);
+}
+
+/* The sidebar's own content panel and New Session button paint the sidebar fill opaquely; macOS
+   clears the panel and re-tints the button, so the column material shows through here too.
+   The panel is matched structurally: its CSS Module hash changes, and the shared "_root" suffix
+   also belongs to transparent panels nested inside the sidebar. */
+html[data-dsh-glass] [class*="sidebarCol"] > div > [class*="_root"] { background: transparent; }
+html[data-dsh-glass] [class$="newSession"] { background: rgb(255 255 255 / 0.55); }
+html[data-dsh-glass] [class$="newSession"]:hover { background: rgb(255 255 255 / 0.3); }
+html[data-dsh-glass] body[data-ds-dark-theme] [class$="newSession"] { background: rgb(255 255 255 / 0.15); }
+html[data-dsh-glass] body[data-ds-dark-theme] [class$="newSession"]:hover { background: rgb(255 255 255 / 0.2); }
+
+/* The list-bottom fade paints a gradient of the opaque sidebar fill. macOS hides it for exactly
+   this reason (over window vibrancy the gradient is a solid smear, not a fade), so the
+   translucent column hides it too; without this it reads as a light band above the footer. */
+html[data-dsh-glass] [class*="sidebarCol"] [class$="_fade"] { display: none; }
+
+/* Content, right bar and bottom row remain opaque. */
+html[data-dsh-glass] [class*="centerCol"],
+html[data-dsh-glass] [class*="rightbarCol"],
+html[data-dsh-glass] [class*="bottomRow"] {
+  background: var(--dsw-alias-bg-base);
+}
+html[data-dsh-glass] [class*="centerCol"] {
+  border-left: .5px solid var(--dsw-alias-border-l3);
+}
+html[data-dsh-glass] [class*="frame"][data-sidebar-collapsed] [class*="centerCol"] {
+  border-left: none;
+}
+
+@media (prefers-reduced-transparency: reduce) {
+  html[data-dsh-glass] [class*="sidebarCol"],
+  html[data-dsh-glass] body[data-ds-dark-theme] [class*="sidebarCol"] {
+    background: color-mix(in srgb, var(--dsw-specific-sidebar-fill) ${reduced}%, transparent);
+  }
+}
+</style>`;
+}
diff --git a/apps/desktop/src/glass-mode.ts b/apps/desktop/src/glass-mode.ts
new file mode 100644
index 0000000..97512e7
--- /dev/null
+++ b/apps/desktop/src/glass-mode.ts
@@ -0,0 +1,25 @@
+/** Runtime opt-in for the macOS-like Linux layout. */
+
+/** Preload argument marking the application document as running in glass mode. */
+export const GLASS_ARGUMENT = '--dsh-desktop-glass'
+
+/**
+ * Whether the user requested glass mode: Linux only, and only the exact value `1`.
+ * @returns true when the primary window uses the Web layout and an auto-hidden menu bar.
+ */
+export function desktopGlass(): boolean {
+  return process.platform === 'linux' && process.env.DSH_DESKTOP_GLASS === '1'
+}
+
+/**
+ * Sidebar fill percentage the user asked for, for compositors that do not blur the window
+ * behind it. Unset or invalid values keep the macOS material in `glass-document.ts`.
+ * @returns 0-100, or null to use the built-in per-theme values.
+ */
+export function glassTint(): number | null {
+  const raw = process.env.DSH_DESKTOP_GLASS_TINT
+  if (raw === undefined) return null
+  if (!/^\d{1,3}$/u.test(raw)) return null
+  const tint = Number(raw)
+  return tint > 100 ? null : tint
+}
