+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { GLASS_ARGUMENT, desktopGlass, glassTint } from '../src/glass-mode.ts'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.unstubAllEnvs()
+})
+
+describe('desktopGlass', () => {
+  it('accepts only the exact value 1 on linux', () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+    for (const value of [undefined, '', '0', 'true', 'yes', 'on', '2']) {
+      vi.stubEnv('DSH_DESKTOP_GLASS', value)
+      expect(desktopGlass()).toBe(false)
+    }
+    vi.stubEnv('DSH_DESKTOP_GLASS', '1')
+    expect(desktopGlass()).toBe(true)
+  })
+
+  it.each(['darwin', 'win32'] as const)('stays off on %s even with the variable set', (platform) => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue(platform)
+    vi.stubEnv('DSH_DESKTOP_GLASS', '1')
+    expect(desktopGlass()).toBe(false)
+  })
+
+  it('names the argument the main process hands to the preload', () => {
+    expect(GLASS_ARGUMENT).toBe('--dsh-desktop-glass')
+  })
+})
+
+describe('glassTint', () => {
+  it('keeps the macOS material when the variable is unset or not a percentage', () => {
+    for (const value of [undefined, '', ' ', 'abc', '0x50', '80%', '-1', '101', '1000']) {
+      vi.stubEnv('DSH_DESKTOP_GLASS_TINT', value)
+      expect(glassTint()).toBeNull()
+    }
+  })
+
+  it('reads whole percentages from 0 to 100', () => {
+    for (const [value, expected] of [['0', 0], ['35', 35], ['80', 80], ['100', 100]] as const) {
+      vi.stubEnv('DSH_DESKTOP_GLASS_TINT', value)
+      expect(glassTint()).toBe(expected)
+    }
+  })
+
+  it('applies on every platform, because only glass mode reads it', () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+    vi.stubEnv('DSH_DESKTOP_GLASS_TINT', '80')
+    expect(glassTint()).toBe(80)
+  })
+})
