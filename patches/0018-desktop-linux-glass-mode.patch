+++ b/apps/desktop/tests/glass-document.spec.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+import { glassDocument } from '../src/glass-document.ts'
+
+/** The list-bottom fade, hidden for the same reason macOS hides it over vibrancy. */
+const FADE_RULE = 'html[data-dsh-glass] [class*="sidebarCol"] [class$="_fade"] { display: none; }'
+
+describe('glassDocument', () => {
+  it('marks the document before its bundles run and closes its own style block', () => {
+    const markup = glassDocument(null)
+    expect(markup.startsWith("<script>document.documentElement.setAttribute('data-dsh-glass','')</script>")).toBe(true)
+    expect(markup.endsWith('</style>')).toBe(true)
+  })
+
+  it('hides the opaque list-bottom fade over the translucent column', () => {
+    expect(glassDocument(null)).toContain(FADE_RULE)
+  })
+
+  it('shows the opaque menu backing macOS uses to keep menus readable over glass', () => {
+    const markup = glassDocument(null)
+    expect(markup).toContain('html[data-dsh-glass] [data-menu-backing] {')
+    expect(markup).toContain('background: var(--dsw-alias-bg-base);')
+  })
+
+  it('clears only the grid frame, not every CSS Module whose name ends in "_frame"', () => {
+    const markup = glassDocument(null)
+    expect(markup).toContain('div:has(> [class*="sidebarCol"]) { background: transparent; }')
+    expect(markup).not.toContain('[class*="_frame"]')
+  })
+
+  it('uses the macOS fills by default and one tint for both themes', () => {
+    const macOS = glassDocument(null)
+    expect(macOS).toContain('#7a9bf0) 40%, transparent)')
+    expect(macOS).toContain('var(--dsw-specific-sidebar-fill) 50%, transparent)')
+    // Reduced transparency never goes clearer than 90, whatever the requested fill.
+    expect(macOS).toContain('var(--dsw-specific-sidebar-fill) 90%, transparent)')
+    const tinted = glassDocument(80)
+    expect(tinted).toContain('#7a9bf0) 80%, transparent)')
+    expect(tinted).toContain('var(--dsw-specific-sidebar-fill) 80%, transparent)')
+    expect(tinted).toContain('var(--dsw-specific-sidebar-fill) 90%, transparent)')
+  })
+})
