+/** Private channels shared by isolated Linux chrome and its owning main frame. */
+export const LINUX_CHROME_ARGUMENT = '--dsh-kde-glass-chrome'
+/** Primary-frame caption style argument; absent or invalid values select macOS traffic lights. */
+export const LINUX_TITLEBAR_STYLE_ARGUMENT = '--dsh-desktop-titlebar-style='
+/** Stable primary-only native title; welcome and settings windows are never selected by the relay. */
+export const LINUX_PRIMARY_WINDOW_TITLE = 'DeepSeek Harness — Workspace'
+/** Native window actions and state; never exposed as an application command bridge. */
+export const LINUX_CHROME_IPC = { action: 'dsh-kde-glass:window-action', state: 'dsh-kde-glass:window-state' } as const
+/** Native state contains no application or Host data. */
+export interface LinuxChromeState { readonly maximized: boolean; readonly fullscreen: boolean; readonly focused: boolean }
diff --git a/apps/desktop/src/linux-window-chrome.ts b/apps/desktop/src/linux-window-chrome.ts
new file mode 100644
index 00000000..a18d192e
--- /dev/null
+++ b/apps/desktop/src/linux-window-chrome.ts
@@ -0,0 +1,51 @@
+/** Private native-window controls for transparent, frameless Linux primary windows. */
+import { ipcMain, type BrowserWindow, type IpcMainEvent } from 'electron'
+
+import { LINUX_CHROME_IPC, type LinuxChromeState } from './linux-chrome-ipc.ts'
+
+/** @param window - Primary transparent window. Installs allowlisted actions and removes the receiver on close. */
+export function installLinuxWindowChrome(window: BrowserWindow): void {
+  const sendState = (): void => {
+    if (!window.isDestroyed()) window.webContents.send(LINUX_CHROME_IPC.state, {
+      maximized: window.isMaximized(), fullscreen: window.isFullScreen(), focused: window.isFocused(),
+    } satisfies LinuxChromeState)
+  }
+  const handleAction = (event: IpcMainEvent, action: unknown): void => {
+    if (window.isDestroyed() || event.sender !== window.webContents || event.senderFrame !== window.webContents.mainFrame) return
+    let url: URL
+    try { url = new URL(event.senderFrame.url) } catch (_error) { return /* No document is authorized before navigation. */ }
+    if (url.protocol !== 'dsh-app:' || url.hostname !== 'app') return
+    switch (action) {
+      case 'close': window.close(); break
+      case 'minimize': window.minimize(); break
+      case 'maximize':
+        if (window.isFullScreen()) window.setFullScreen(false)
+        else if (window.isMaximized()) window.unmaximize()
+        else window.maximize()
+        break
+      default: return
+    }
+  }
+  ipcMain.on(LINUX_CHROME_IPC.action, handleAction)
+  window.on('maximize', sendState)
+  window.on('unmaximize', sendState)
+  window.on('enter-full-screen', sendState)
+  window.on('leave-full-screen', sendState)
+  window.on('focus', sendState)
+  window.on('blur', sendState)
+  window.webContents.on('did-finish-load', sendState)
+  window.once('closed', () => { ipcMain.removeListener(LINUX_CHROME_IPC.action, handleAction) })
+}
+
+/** @param window - Transparent primary window. @param radius - Validated radius in device-independent pixels. */
+export function installLinuxCornerRadius(window: BrowserWindow, radius: number): void {
+  const update = (): void => {
+    if (!window.isDestroyed()) window.contentView.setBorderRadius(window.isMaximized() || window.isFullScreen() ? 0 : radius)
+  }
+  window.on('resize', update)
+  window.on('maximize', update)
+  window.on('unmaximize', update)
+  window.on('enter-full-screen', update)
+  window.on('leave-full-screen', update)
+  update()
+}
