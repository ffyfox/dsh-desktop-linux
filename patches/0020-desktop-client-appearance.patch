+  expect(await f.save({ ...next, titlebarStyle: 'native' })).toMatchObject({ kind: 'error', problem: { kind: 'fields', field: 'titlebarStyle' } })
+  expect(await appearance.readClientAppearance(f.root, {})).toEqual(next)
+})
