+
+  it.each(['macos', 'windows'] as const)('migrates v2 %s without rewriting the file or changing other saved preferences', async titlebarStyle => {
+    const legacy = { ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle, sidebarOpacity: 63, cornerRadius: 7, systemShadow: false,
+      frameless: false, sidebarGlass: false, waylandBlur: false }
+    const raw = JSON.stringify({ schemaVersion: 2, ...legacy })
+    const { root, path } = await fixture(raw)
+    const expected = { ...legacy, titlebarStyle: titlebarStyle === 'windows' ? 'fusion' as const : 'macos' as const }
+    expect(await readClientAppearance(root, { DSH_DESKTOP_GLASS_TINT: '25' })).toEqual(expected)
+    expect(await readFile(path, 'utf8')).toBe(raw)
+    await saveClientAppearance(root, expected)
+    expect(JSON.parse(await readFile(path, 'utf8'))).toEqual({ schemaVersion: 3, ...expected })
+    expect(await readClientAppearance(root, {})).toEqual(expected)
+  })
+
+  it.each(['macos', 'windows', 'fusion'] as const)('round-trips a v3 %s choice without applying legacy migration', async titlebarStyle => {
+    const { root, path } = await fixture()
+    const next = { ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle }
+    expect(await saveClientAppearance(root, next)).toEqual(next)
+    expect(JSON.parse(await readFile(path, 'utf8'))).toEqual({ schemaVersion: 3, ...next })
+    expect(await readClientAppearance(root, {})).toEqual(next)
+  })
+
+  it('uses legacy values only before the first save, with file values winning on subsequent reads', async () => {
+    const { root } = await fixture()
+    const env = { DSH_DESKTOP_FRAMELESS: '0', DSH_DESKTOP_GLASS: '0', DSH_DESKTOP_GLASS_TINT: '75' }
+    const current = await readClientAppearance(root, env)
+    expect(current).toEqual({ ...DEFAULT_CLIENT_APPEARANCE, frameless: false, sidebarGlass: false, sidebarOpacity: 75 })
+    const saved = await saveClientAppearance(root, { ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 0, sidebarOpacity: 20 })
+    expect(await readClientAppearance(root, env)).toEqual(saved)
+    expect(current).toEqual({ ...DEFAULT_CLIENT_APPEARANCE, frameless: false, sidebarGlass: false, sidebarOpacity: 75 })
+    expect(env).toEqual({ DSH_DESKTOP_FRAMELESS: '0', DSH_DESKTOP_GLASS: '0', DSH_DESKTOP_GLASS_TINT: '75' })
+  })
+
+  it.each(['', '-1', '101', '1.5', '50%', ' 50', '50\n', '1000', 'NaN'])('does not import invalid legacy tint %j', async tint => {
+    const { root } = await fixture()
+    expect((await readClientAppearance(root, { DSH_DESKTOP_GLASS_TINT: tint })).sidebarOpacity).toBe(80)
+  })
+
+  it.each(['0', '100', '001'])('accepts integer legacy tint %s', async tint => {
+    const { root } = await fixture()
+    expect((await readClientAppearance(root, { DSH_DESKTOP_GLASS_TINT: tint })).sidebarOpacity).toBe(Number(tint))
+  })
+
+  it('retains exact legacy boolean opt-in semantics for explicitly supplied values', async () => {
+    const { root } = await fixture()
+    for (const raw of ['1', 'true', '', '0']) {
+      const value = await readClientAppearance(root, { DSH_DESKTOP_FRAMELESS: raw, DSH_DESKTOP_GLASS: raw })
+      expect(value.frameless).toBe(raw === '1')
+      expect(value.sidebarGlass).toBe(raw === '1')
+    }
+  })
+
+  it('round-trips a versioned document using only appearance fields and never opens unrelated settings', async () => {
+    const { root, path } = await fixture()
+    const settings = join(root, 'desktop', 'settings.json')
+    await mkdir(dirname(settings))
+    await writeFile(settings, 'unrelated-file-must-stay-unread')
+    const read = vi.spyOn(fs, 'readFile')
+    const value = { ...DEFAULT_CLIENT_APPEARANCE, systemShadow: false, cornerRadius: 32, sidebarOpacity: 0 }
+    expect(await saveClientAppearance(root, value)).toEqual(value)
+    expect(await readClientAppearance(root, {})).toEqual(value)
+    expect(read.mock.calls.every(([file]) => file === path)).toBe(true)
+    expect(JSON.parse(await readFile(path, 'utf8'))).toEqual({ schemaVersion: 3, ...value })
+    expect(await readFile(settings, 'utf8')).toBe('unrelated-file-must-stay-unread')
+  })
+
+  it.skipIf(process.platform === 'win32')('replaces wider file permissions with owner-only mode', async () => {
+    const { root, path } = await fixture(JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE }))
+    await fs.chmod(path, 0o644)
+    await saveClientAppearance(root, DEFAULT_CLIENT_APPEARANCE)
+    expect((await stat(path)).mode & 0o777).toBe(0o600)
+  })
+
+  it.each([
+    ['{"private":"do-not-quote"', 'json'], ['null', 'document'], ['[]', 'document'],
+    [JSON.stringify({ ...DEFAULT_CLIENT_APPEARANCE }), 'version'],
+    [JSON.stringify({ schemaVersion: '1', ...DEFAULT_CLIENT_APPEARANCE }), 'version'],
+    [JSON.stringify({ schemaVersion: 4, ...DEFAULT_CLIENT_APPEARANCE }), 'version'],
+    [JSON.stringify({ schemaVersion: 3, ...DEFAULT_CLIENT_APPEARANCE, future: true }), 'document'],
+    [JSON.stringify({ schemaVersion: 3, ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle: 'native' }), 'fields'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle: 'fusion' }), 'fields'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle: 'Windows' }), 'fields'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE, future: true }), 'document'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 40 }), 'fields'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE, systemShadow: 'false' }), 'fields'],
+    [JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle: 'native' }), 'fields'],
+    [JSON.stringify({ schemaVersion: 1, ...DEFAULT_CLIENT_APPEARANCE }), 'document'],
+    [JSON.stringify({ schemaVersion: 1, ...versionOneAppearance, future: true }), 'document'],
+    [JSON.stringify({ schemaVersion: 1, ...versionOneAppearance, cornerRadius: 40 }), 'fields'],
+    [JSON.stringify({ schemaVersion: 1, ...versionOneAppearance, sidebarOpacity: '50' }), 'fields'],
+    [JSON.stringify({ schemaVersion: 2, ...versionOneAppearance }), 'document'],
+  ])('reports invalid persisted documents and never replaces them: %s', async (raw, kind) => {
+    const { root, path } = await fixture(raw)
+    await expect(readClientAppearance(root, {})).rejects.toMatchObject({ name: 'ClientAppearanceError', problem: { kind } })
+    await expect(saveClientAppearance(root, DEFAULT_CLIENT_APPEARANCE)).rejects.toMatchObject({ problem: { kind } })
+    expect(await readFile(path, 'utf8')).toBe(raw)
+    try { await readClientAppearance(root, {}) } catch (error) { expect(String(error)).not.toContain('do-not-quote') }
+  })
+
+  it('rejects invalid IPC input before creating directories or replacing a file', async () => {
+    const { root } = await fixture()
+    await expect(saveClientAppearance(root, { ...DEFAULT_CLIENT_APPEARANCE, sidebarOpacity: 0.5 })).rejects.toMatchObject({ problem: { kind: 'fields' } })
+    expect(await readdir(root)).toEqual([])
+  })
+
+  it('reports unreadable files instead of silently selecting defaults', async () => {
+    const { root, path } = await fixture()
+    await mkdir(path, { recursive: true })
+    await expect(readClientAppearance(root, {})).rejects.toMatchObject({ problem: { kind: 'read' } })
+    expect((await stat(path)).isDirectory()).toBe(true)
+  })
+
+  it.each(['mkdir', 'writeFile', 'rename'] as const)('preserves the original bytes and removes temporary files after %s failure', async operation => {
+    const raw = JSON.stringify({ schemaVersion: 2, ...DEFAULT_CLIENT_APPEARANCE })
+    const { root, path } = await fixture(raw)
+    vi.spyOn(fs, operation).mockRejectedValueOnce(Object.assign(new Error('injected filesystem failure'), { code: 'EIO' }))
+    await expect(saveClientAppearance(root, { ...DEFAULT_CLIENT_APPEARANCE, cornerRadius: 3 })).rejects.toMatchObject({ problem: { kind: 'write' } })
+    expect(await readFile(path, 'utf8')).toBe(raw)
+    expect(await readdir(dirname(path))).toEqual(['appearance.json'])
