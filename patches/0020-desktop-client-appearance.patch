+import { launchWaylandProxy, prepareAppearanceRestart, waylandProxyPython } from '../src/wayland-bootstrap.ts'
+
+const native = vi.hoisted(() => ({
+  releaseSingleInstanceLock: vi.fn(), relaunch: vi.fn(), exists: vi.fn(() => true), write: vi.fn(async () => {}),
+  spawn: vi.fn(),
+}))
+vi.mock('electron', () => ({ app: native }))
+vi.mock('node:child_process', () => ({ spawn: native.spawn }))
+vi.mock('node:fs', () => ({ existsSync: native.exists }))
+vi.mock('node:fs/promises', () => ({ writeFile: native.write }))
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE', undefined)
+  vi.stubEnv('DSH_WAYLAND_PROXY_RESTART_FILE', undefined)
+  vi.stubEnv('WAYLAND_DISPLAY', 'wayland-1')
+  vi.stubEnv('ELECTRON_RUN_AS_NODE', '1')
+})
+
+afterEach(() => { vi.unstubAllEnvs(); vi.restoreAllMocks() })
+
+it('launches bundled Python with one isolated Wayland relay and releases only its own initial lock', async () => {
+  const child = Object.assign(new EventEmitter(), { unref: vi.fn() })
+  native.spawn.mockImplementation(() => { queueMicrotask(() => child.emit('spawn')); return child })
+  await expect(launchWaylandProxy(DEFAULT_CLIENT_APPEARANCE, {python:'/bundle/python3',proxy:'/bundle/proxy.py'})).resolves.toBe(true)
+  expect(native.releaseSingleInstanceLock).toHaveBeenCalledOnce()
+  expect(native.spawn).toHaveBeenCalledWith('/bundle/python3',expect.arrayContaining([
+    '/bundle/proxy.py','--surface-title','DeepSeek Harness — Workspace','--corner-radius','12','--shadow','--',process.execPath,
+  ]),expect.objectContaining({detached:true,stdio:'inherit',env:expect.not.objectContaining({ELECTRON_RUN_AS_NODE:'1'})}))
+  expect(child.unref).toHaveBeenCalledOnce()
+})
+
+it('does not rewrap the supervised child or a non-frameless application', async () => {
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE','1')
+  expect(await launchWaylandProxy(DEFAULT_CLIENT_APPEARANCE,{python:'/x',proxy:'/y'})).toBe(false)
+  vi.stubEnv('DSH_WAYLAND_PROXY_ACTIVE',undefined)
+  expect(await launchWaylandProxy({...DEFAULT_CLIENT_APPEARANCE,frameless:false,sidebarGlass:false},{python:'/x',proxy:'/y'})).toBe(false)
+  expect(native.spawn).not.toHaveBeenCalled()
+})
