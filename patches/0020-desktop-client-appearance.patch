+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--runtime', help='Electron executable prepended to command arguments')
+    parser.add_argument('--verbose', action='store_true', help='log injected protocol, never window content')
+    parser.add_argument('--no-blur', action='store_true', help='disable blur; shadow remains independent')
+    parser.add_argument('--corner-radius', type=corner_radius, default=0, metavar='0..32',
+                        help='surface-local radius; caller must apply matching alpha clipping')
+    shadow_group = parser.add_mutually_exclusive_group()
+    shadow_group.add_argument('--shadow', dest='shadow', action='store_true', help='enable native KDE compositor shadow')
+    shadow_group.add_argument('--no-shadow', dest='shadow', action='store_false', help='do not inject a compositor shadow')
+    parser.set_defaults(shadow=False)
+    parser.add_argument('--surface-title', default='', help='inject only windows with this initial exact xdg title; empty selects all')
+    parser.add_argument('--upstream', help='real Wayland display name or absolute socket path')
+    parser.add_argument('command', nargs=argparse.REMAINDER)
+    args = parser.parse_args()
+    command = args.command[1:] if args.command[:1] == ['--'] else args.command
+    if args.runtime:
+        command.insert(0, args.runtime)
+    if not command:
+        parser.error('provide -- <command> [arguments]')
+    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', ''))
+    if not runtime.is_absolute() or not runtime.is_dir():
+        parser.error('XDG_RUNTIME_DIR must be an existing absolute directory')
+    display = args.upstream or os.environ.get('WAYLAND_DISPLAY', 'wayland-0')
+    upstream = display if os.path.isabs(display) else str(runtime / display)
+    result = 1
+    with tempfile.TemporaryDirectory(prefix='dsh-wayland-blur-', dir=runtime) as directory:
+        endpoint = str(Path(directory) / 'wayland-0')
+        restart_path = Path(directory) / 'restart.json'
+        env = os.environ.copy()
+        env['WAYLAND_DISPLAY'] = endpoint
+        env['DSH_WAYLAND_PROXY_RESTART_FILE'] = str(restart_path)
+        env['DSH_WAYLAND_PROXY_ACTIVE'] = '1'
+        env.pop('WAYLAND_SOCKET', None)
+        child = None
+        previous = {}
+        def forward(signum, _frame):
+            if child is not None:
+                try:
+                    os.killpg(child.pid, signum)
+                except ProcessLookupError:
+                    pass  # The dedicated child group already exited.
+            raise SystemExit(128 + signum)
+        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
+            previous[signum] = signal.signal(signum, forward)
+        try:
+            while True:
+                server = ProxyServer(endpoint, upstream, args.verbose, not args.no_blur,
+                                     args.corner_radius, args.shadow, args.surface_title)
+                worker = threading.Thread(target=server.serve, name='wlblur-listener', daemon=True)
+                worker.start()
+                try:
+                    child = subprocess.Popen(command, env=env, start_new_session=True)
+                    print(f'[wlblur-proxy] endpoint={endpoint} child_pid={child.pid}', file=sys.stderr, flush=True)
+                    result = child.wait()
+                finally:
+                    if child is not None:
+                        terminate_child(child)
+                        child = None
+                    # Stop acceptance before draining relay threads; the socket
+                    # name stays private and is rebound only after full cleanup.
+                    server.stop.set()
+                    worker.join()
+                    server.close()
+                if result != 0:
+                    break
+                try:
+                    restart = consume_restart(restart_path)
+                except (OSError, ValueError) as error:
+                    print(f'[wlblur-proxy] ERROR: invalid restart request ({type(error).__name__}); stopped', file=sys.stderr, flush=True)
+                    result = 1
+                    break
+                if restart is None:
+                    break
+                args.corner_radius = restart['cornerRadius']
+                args.shadow = restart['systemShadow']
+                args.no_blur = not restart['waylandBlur']
+                print('[wlblur-proxy] restarting child with updated appearance', file=sys.stderr, flush=True)
+        finally:
+            for signum, handler in previous.items():
+                signal.signal(signum, handler)
+    return result if result >= 0 else 128 - result
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
