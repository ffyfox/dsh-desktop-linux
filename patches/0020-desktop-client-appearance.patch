+def consume_restart(path: Path) -> dict | None:
+    """Consume one owner-only, bounded JSON request from the private proxy dir.
+
+    Only the exact three documented fields are accepted. Invalid requests stop
+    supervision instead of relaunching with partially trusted configuration.
+    """
+    try:
+        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    except FileNotFoundError:
+        return None
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_size > 4096:
+            raise ValueError('restart file must be an owned regular JSON file of at most 4096 bytes')
+        data = os.read(descriptor, 4097)
+    finally:
+        os.close(descriptor)
+    path.unlink()
+    def unique_object(pairs):
+        value = {}
+        for key, item in pairs:
+            if key in value:
+                raise ValueError('duplicate restart field')
+            value[key] = item
+        return value
+    value = json.loads(data, object_pairs_hook=unique_object)
+    if (not isinstance(value, dict) or set(value) != {'cornerRadius', 'systemShadow', 'waylandBlur'} or
+            type(value['cornerRadius']) is not int or not 0 <= value['cornerRadius'] <= 32 or
+            type(value['systemShadow']) is not bool or type(value['waylandBlur']) is not bool):
+        raise ValueError('restart JSON requires cornerRadius:0..32, systemShadow:boolean, waylandBlur:boolean')
+    return value
+
+
+def terminate_child(child) -> None:
+    """Reap this supervisor's child and terminate only its dedicated process group."""
+    try:
+        os.killpg(child.pid, signal.SIGTERM)
+    except ProcessLookupError:
+        pass  # This owned group already exited.
+    try:
+        child.wait(timeout=3)
+    except subprocess.TimeoutExpired:
+        pass  # SIGKILL below is bounded escalation for this owned group only.
+    try:
+        os.killpg(child.pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass  # This owned group already exited.
+    child.wait()
+
