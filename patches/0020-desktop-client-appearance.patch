+  const next = { ...DEFAULT_CLIENT_APPEARANCE, titlebarStyle }
+  expect(await f.save(next)).toMatchObject({ kind: 'ok', value: {
+    current: DEFAULT_CLIENT_APPEARANCE, saved: next, restartRequired: true,
