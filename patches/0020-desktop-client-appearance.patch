+++ b/apps/desktop/renderer/client-settings/messages.json
@@ -0,0 +1,138 @@
+{
+  "en": {
+    "title": "Client appearance",
+    "subtitle": "Window and sidebar preferences for this desktop app",
+    "windowGroup": "Window",
+    "titlebarStyle": "Title bar style",
+    "titlebarHelp": "macOS uses left-side traffic lights. Windows uses the upstream separate 40 px title bar with menus. Blended places controls on the logo and sidebar-toggle row. Applies to the frameless main window after restart; native decorations are unchanged.",
+    "titlebarMacos": "macOS",
+    "titlebarWindows": "Windows",
+    "titlebarFusion": "Blended",
+    "titlebarInvalid": "Choose macOS, Windows, or Blended title bar style.",
+    "cornerRadius": "Corner radius",
+    "cornerHelp": "0–32 px. The compositor decides whether native corners can be rounded.",
+    "cornerValue": "Corner radius in pixels",
+    "shadow": "System shadow",
+    "shadowHelp": "Request a native window shadow. Availability depends on the compositor.",
+    "sidebarGroup": "Sidebar",
+    "glass": "Sidebar glass",
+    "glassHelp": "Use a translucent sidebar. The main content stays opaque.",
+    "transparency": "Transparency",
+    "transparencyHelp": "0% is fully opaque; 100% is fully transparent. Increase the fill if background details make text hard to read.",
+    "transparencyValue": "Sidebar transparency percentage",
+    "opaque": "Opaque",
+    "transparent": "Transparent",
+    "advanced": "Advanced",
+    "frameless": "Frameless main window",
+    "framelessHelp": "Use the app title bar instead of native window decorations. This settings window keeps its native frame.",
+    "blur": "Wayland background blur",
+    "blurHelp": "Request compositor blur behind the sidebar. Requires a supported Wayland compositor; the effect is not guaranteed.",
+    "environmentHelp": "Before your first save, DSH_DESKTOP_FRAMELESS, DSH_DESKTOP_GLASS and DSH_DESKTOP_GLASS_TINT supply compatible initial values. After saving, the appearance file takes precedence over these variables.",
+    "privacyHelp": "Stored separately in desktop/appearance.json under this app’s user data. API credentials are not read or included.",
+    "restartHelp": "Changes apply only after restarting the app. Saving does not change the current run.",
