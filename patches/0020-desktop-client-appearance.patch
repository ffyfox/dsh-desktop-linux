--- /dev/null
+++ b/apps/desktop/tests/preload-linux-chrome.client.spec.ts
@@ -0,0 +1,154 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { installLinuxChrome } from '../src/preload-linux-chrome.ts'
+import { LINUX_CHROME_ARGUMENT, LINUX_CHROME_IPC, LINUX_TITLEBAR_STYLE_ARGUMENT } from '../src/linux-chrome-ipc.ts'
+
+const { send, on, removeListener } = vi.hoisted(() => ({ send: vi.fn(), on: vi.fn(), removeListener: vi.fn() }))
+vi.mock('electron', () => ({ ipcRenderer: { send, on, removeListener } }))
+const originalArgv = process.argv
+const originalMainFrame = Object.getOwnPropertyDescriptor(process, 'isMainFrame')
+let shadow: ShadowRoot | undefined
+
+beforeEach(() => {
+  process.argv = [...originalArgv, LINUX_CHROME_ARGUMENT]
+  Object.defineProperty(process, 'isMainFrame', { configurable: true, value: true })
+  vi.stubGlobal('location', { protocol: 'dsh-app:', hostname: 'app' })
+  vi.stubGlobal('ResizeObserver', class { observe = vi.fn(); unobserve = vi.fn(); disconnect = vi.fn() })
+  vi.spyOn(document, 'readyState', 'get').mockReturnValue('complete')
+  const attach = HTMLElement.prototype.attachShadow
+  vi.spyOn(HTMLElement.prototype, 'attachShadow').mockImplementation(function (this: HTMLElement, init) {
+    shadow = attach.call(this, init)
+    return shadow
+  })
+  document.documentElement.lang = 'en'
+  document.body.innerHTML = ''
+})
+
+afterEach(() => {
+  window.dispatchEvent(new Event('pagehide'))
+  process.argv = originalArgv
+  if (originalMainFrame === undefined) Reflect.deleteProperty(process, 'isMainFrame')
+  else Object.defineProperty(process, 'isMainFrame', originalMainFrame)
+  document.body.innerHTML = ''
+  document.documentElement.lang = 'en'
+  vi.restoreAllMocks(); vi.unstubAllGlobals()
+  send.mockClear(); on.mockClear(); removeListener.mockClear(); shadow = undefined
+})
+
+function state(value: unknown): void {
+  const handler = on.mock.calls.at(-1)?.[1] as (event: undefined, value: unknown) => void
+  handler(undefined, value)
+}
+function buttons(): HTMLButtonElement[] { return [...(shadow?.querySelectorAll('button') ?? [])] }
+function blended(): void { process.argv.push(`${LINUX_TITLEBAR_STYLE_ARGUMENT}fusion`); installLinuxChrome() }
+
+it('preserves macOS traffic-light order, diameter and leading clearance by default', () => {
+  installLinuxChrome()
+  expect(document.documentElement.dataset.dshTitlebarStyle).toBe('macos')
+  expect(buttons().map(button => button.dataset.action)).toEqual(['close', 'minimize', 'maximize'])
+  expect(shadow?.querySelector('style')?.textContent).toContain('width:12px; height:12px; border-radius:50%')
+  expect(document.head.lastElementChild?.textContent).toContain('--dsh-frame-leading-clearance:160px')
+  expect(document.querySelector('dsh-kde-window-controls')?.shadowRoot).toBeNull()
+  expect(document.documentElement.hasAttribute('data-windows-titlebar')).toBe(false)
+})
+
+it('falls back to macOS for an invalid style and rejects unmarked or foreign frames', () => {
+  process.argv.push(`${LINUX_TITLEBAR_STYLE_ARGUMENT}invalid`)
+  installLinuxChrome()
+  expect(document.documentElement.dataset.dshTitlebarStyle).toBe('macos')
+  window.dispatchEvent(new Event('pagehide'))
+  process.argv = originalArgv
+  installLinuxChrome()
+  expect(document.querySelector('dsh-kde-window-controls')).toBeNull()
+  process.argv = [...originalArgv, LINUX_CHROME_ARGUMENT]
+  vi.stubGlobal('location', { protocol: 'https:', hostname: 'app' })
+  installLinuxChrome()
+  expect(document.querySelector('dsh-kde-window-controls')).toBeNull()
+})
+
+it('renders right-side Blended controls and a shared brand/toggle row without caption menus', () => {
+  blended()
+  expect(document.documentElement.dataset.dshTitlebarStyle).toBe('fusion')
+  expect(buttons().map(button => button.dataset.action)).toEqual(['minimize', 'maximize', 'close'])
+  expect(document.documentElement.hasAttribute('data-windows-titlebar')).toBe(false)
+  expect(document.querySelector('dsh-kde-window-controls')?.shadowRoot).toBeNull()
+  const css = shadow?.querySelector('style')?.textContent
+  expect(css).toContain('right:0; width:138px; height:48px')
+  expect(css).toContain('width:46px; height:48px')
+  expect(css).toContain('button[data-action=close]:hover { background:#c42b1c; color:white; }')
+  expect(css).toContain(':host(:is([data-style=windows],[data-style=fusion])) [data-glyph=close]::before, :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=close]::after { content:"";')
+  expect(document.head.lastElementChild?.textContent).toContain('html[data-dsh-titlebar-style=fusion] [data-shell-leading]')
+  expect(document.head.lastElementChild?.textContent).toContain('[data-window-drag]:has(> [data-sidebar-toggle]) { height:0;')
+  expect(document.head.lastElementChild?.textContent).toContain('[data-window-drag] > [data-sidebar-toggle] { position:absolute; top:11px; right:12px;')
+})
+
+it('uses a compact forty-pixel Windows control row without adding content-row clearance', () => {
+  process.argv.push(`${LINUX_TITLEBAR_STYLE_ARGUMENT}windows`)
+  installLinuxChrome()
+  expect(document.documentElement.dataset.dshTitlebarStyle).toBe('windows')
+  expect(buttons().map(button => button.dataset.action)).toEqual(['minimize', 'maximize', 'close'])
+  expect(shadow?.querySelector('style')?.textContent).toContain('right:0; width:138px; height:40px')
+  expect(shadow?.querySelector('style')?.textContent).toContain('width:46px; height:40px')
+  expect(document.querySelector('[data-dsh-caption-clearance]')).toBeNull()
+})
+
+it('updates restore glyph and bilingual labels and rejects malformed state', () => {
+  blended()
+  const maximize = buttons().find(button => button.dataset.action === 'maximize')!
+  state({ maximized: true, fullscreen: false, focused: false })
+  expect(maximize.getAttribute('aria-label')).toBe('Restore window')
+  expect(maximize.querySelector('span')?.dataset.glyph).toBe('restore')
+  expect(document.querySelector('dsh-kde-window-controls')?.hasAttribute('data-inactive')).toBe(true)
+  state({ maximized: false, fullscreen: 'wrong', focused: true })
+  expect(maximize.querySelector('span')?.dataset.glyph).toBe('restore')
+  document.documentElement.lang = 'zh-CN'
+  state({ maximized: false, fullscreen: false, focused: true })
+  expect(maximize.getAttribute('aria-label')).toBe('最大化窗口')
+  expect(maximize.querySelector('span')?.dataset.glyph).toBe('maximize')
+})
+
+it('retains trusted-click IPC and offers no callable page bridge', () => {
+  blended()
+  for (const button of buttons()) button.click()
