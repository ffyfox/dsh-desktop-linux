+    defaults: DEFAULT_CLIENT_APPEARANCE, restartRequired: true,
+  } })
+  button('save-restart').click()
+  await vi.waitFor(() => { expect(api.restart).toHaveBeenCalledOnce() })
+  expect(api.save.mock.invocationCallOrder[0]!).toBeLessThan(api.restart.mock.invocationCallOrder[0]!)
+  expect(text('status')).toBe(reply.messages.restartCancelled)
