+      :host(:is([data-style=windows],[data-style=fusion])) button:focus-visible { outline-offset:-3px; }
+      :host(:is([data-style=windows],[data-style=fusion])) span { position:relative; display:block; width:12px; height:12px; opacity:1; color:inherit; font-size:0; }
+      :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=minimize]::before { content:""; position:absolute; left:1px; right:1px; top:7px; height:1px; background:currentColor; }
+      :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=maximize]::before { content:""; position:absolute; inset:1px; border:1px solid currentColor; }
+      :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=restore]::before { content:""; position:absolute; inset:3px 2px 0 0; border:1px solid currentColor; }
+      :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=restore]::after { content:""; position:absolute; inset:0 0 3px 3px; border-top:1px solid currentColor; border-right:1px solid currentColor; }
+      :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=close]::before, :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=close]::after { content:""; position:absolute; left:5.5px; top:-1px; width:1px; height:14px; background:currentColor; transform:rotate(45deg); }
+      :host(:is([data-style=windows],[data-style=fusion])) [data-glyph=close]::after { transform:rotate(-45deg); }
+    `
+    shadow.append(chromeStyle)
+    const controls = captionStyle !== 'macos'
+      ? [['minimize', '#febc2e', '−'], ['maximize', '#28c840', '+'], ['close', '#ff5f57', '×']] as const
+      : [['close', '#ff5f57', '×'], ['minimize', '#febc2e', '−'], ['maximize', '#28c840', '+']] as const
+    for (const [action, dot, symbol] of controls) {
+      const button = document.createElement('button')
+      button.type = 'button'; button.title = label(action); button.setAttribute('aria-label', button.title)
+      button.dataset.action = action; button.style.setProperty('--dot', dot)
