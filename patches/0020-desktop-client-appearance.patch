+      button:active::before { filter:brightness(.8); }
+      :host([data-inactive]:not(:hover)) button::before { background:#92959b88; }
+      :host(:is([data-style=windows],[data-style=fusion])) { top:0; left:auto; right:0; width:138px; height:${captionHeight}px; color:var(--dsw-alias-label-primary,#242424); }
+      :host(:is([data-style=windows],[data-style=fusion])) button { width:46px; height:${captionHeight}px; border-radius:0; color:inherit; }
+      :host(:is([data-style=windows],[data-style=fusion])) button::before { display:none; }
+      :host(:is([data-style=windows],[data-style=fusion])) button:hover { background:var(--dsw-alias-interactive-bg-hover,#8882); }
+      :host(:is([data-style=windows],[data-style=fusion])) button:active { background:#8884; }
+      :host(:is([data-style=windows],[data-style=fusion])) button[data-action=close]:hover { background:#c42b1c; color:white; }
