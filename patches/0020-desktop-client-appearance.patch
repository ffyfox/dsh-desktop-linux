+#!/usr/bin/env python3
+"""Native Wayland blur relay, independent of Chromium's libwayland linkage.
+
+No private libwayland ABI, ID guessing, client protocol rewriting, or sandbox
+switches. A bounded number of *deleted* client callback/region IDs are retained
+by withholding their delete_id events. The client therefore cannot reuse those
+slots; the relay can legally reuse them for its own registry/effects. Arbitrary
+high IDs are NOT legal: wl_map_reserve_new rejects gaps. Initial negotiation is
+pass-through and appearance effects may only become available after first frames.
+
+CLI: --corner-radius 0..32 (default 0), --shadow/--no-shadow (default off),
+--no-blur, --surface-title TITLE (optional initial exact title filter),
+--upstream DISPLAY, and -- COMMAND ARG.... Radius is in surface coordinates;
+the caller must apply matching content alpha clipping. Native client blur or
+shadow protocols take precedence independently. Maximized/fullscreen configure
+state disables rounded blur and unsets our compositor shadow until floating.
+
+The owned child receives DSH_WAYLAND_PROXY_ACTIVE=1 and an absolute
+DSH_WAYLAND_PROXY_RESTART_FILE inside this process's private runtime directory.
+Before normal exit 0 it may atomically write exactly {"cornerRadius":0..32,
+"systemShadow":boolean,"waylandBlur":boolean} to request a clean supervised
+restart. Nonzero exit, invalid JSON or no request stops the supervisor. Each
+round reaps its dedicated child process group and all relay threads; no caller
+or existing compositor process is terminated. The socket path remains stable
+but the listener is rebound only after old connections are fully closed.
+
+Each connection has its own registry, capabilities, ID pool and FD FIFO. Only
+our events and retained delete_id notifications are hidden from the client.
+"""
+from __future__ import annotations
+
+import argparse
+import array
+from collections import deque
+from dataclasses import dataclass
+import os
+import math
+import json
+import stat
+from pathlib import Path
+import selectors
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+
+U32 = struct.Struct('=I')
+HEADER = struct.Struct('=II')
+MAX_BUFFER = 16 * 1024 * 1024
+MAX_OWN_IDS = 64  # Connection-wide quarantine ceiling, including all shadow tiles.
+SERVER_ID_START = 0xff000000
+
+
+def words(*values: int) -> bytes:
+    return struct.pack('=' + 'I' * len(values), *values)
+
+
+def string(value: str) -> bytes:
+    data = value.encode() + b'\0'
+    return U32.pack(len(data)) + data + b'\0' * (-len(data) % 4)
+
+
+def message(object_id: int, opcode: int, payload: bytes = b'') -> bytes:
+    size = 8 + len(payload)
+    if size > 65532 or size % 4:
+        raise ValueError('invalid Wayland message size')
+    return HEADER.pack(object_id, (size << 16) | opcode) + payload
+
+
+def read_string(data: bytes, offset: int) -> tuple[str, int]:
+    size = U32.unpack_from(data, offset)[0]
+    offset += 4
+    if not size or offset + size > len(data) or data[offset + size - 1] != 0:
+        raise ValueError('invalid Wayland string')
+    return data[offset:offset + size - 1].decode(), offset + (size + 3) // 4 * 4
+
+
+def close_fds(fds: list[int]) -> None:
+    for fd in fds:
+        os.close(fd)
+    fds.clear()
+
+
+class Framer:
+    """Wayland streams and SCM_RIGHTS are separate, ordered FIFOs."""
+    def __init__(self) -> None:
+        self.data = bytearray()
+        self.fds: list[int] = []
+        self.received_fd_count = 0
+
+    def receive(self, peer: socket.socket) -> bool:
+        data, ancillary, flags, _ = peer.recvmsg(
+            65536, socket.CMSG_SPACE(256 * array.array('i').itemsize),
+            getattr(socket, 'MSG_CMSG_CLOEXEC', 0))
+        for level, kind, value in ancillary:
+            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
+                descriptors = array.array('i')
+                descriptors.frombytes(value[:len(value) // descriptors.itemsize * descriptors.itemsize])
+                self.fds.extend(descriptors)
+                self.received_fd_count += len(descriptors)
+        if flags & socket.MSG_CTRUNC:
+            raise ValueError('ancillary FD data truncated')
+        self.data.extend(data)
+        if len(self.data) > MAX_BUFFER:
+            raise ValueError('Wayland receive buffer limit')
+        return bool(data)
+
+    def pop(self) -> bytes | None:
+        if len(self.data) < 8:
+            return None
+        _, size_opcode = HEADER.unpack_from(self.data)
+        size = size_opcode >> 16
+        if size < 8 or size % 4:
+            raise ValueError('invalid Wayland frame')
+        if len(self.data) < size:
+            return None
+        result = bytes(self.data[:size])
+        del self.data[:size]
+        return result
+
+    def take_fds(self) -> list[int]:
+        result, self.fds = self.fds, []
+        return result
+
+
+@dataclass
+class Packet:
+    data: bytes
+    fds: list[int]
+    trace: str = ''
+    offset: int = 0
+
+
+class BlurState:
+    """Only parse the few public messages required for blur; never rewrite IDs."""
+    def __init__(self, inject, log, enabled: bool = True, corner_radius: int = 0,
+                 shadow: bool = False, inject_fds=None, may_inject_fds=None, surface_title: str = '') -> None:
+        self.inject = inject
+        self.log = log
+        self.enabled = enabled
+        if not 0 <= corner_radius <= 32:
+            raise ValueError('corner radius must be in 0..32')
+        self.corner_radius = corner_radius
+        self.shadow_enabled = shadow
+        self.surface_title = surface_title
+        self.selected: set[int] = set()
+        self.inject_fds = inject_fds
+        self.may_inject_fds = may_inject_fds or (lambda: True)
+        self.shadow_global = 0
+        self.shm_global = 0
+        self.shadow_manager = 0
+        self.shm = 0
+        self.shadow_buffers: list[int] = []
+        self.shadows: dict[int, int] = {}
+        self.native_shadow = False
+        self.geometry: dict[int, tuple[int, int, int, int]] = {}
+        self.blocked: set[int] = set()
+        self.toplevel_surfaces: dict[int, int] = {}
+        self.pending_config: dict[int, tuple[int, int, bool]] = {}
+        self.configures: dict[int, dict[int, tuple[int, int, bool]]] = {}
+        self.applied_regions: dict[int, tuple[int, int, int, int, int]] = {}
+        self.regions: dict[int, int] = {}
+        self.budget_warned = False
+        self.expected_client_fds = 0
+        self.objects = {1: 'wl_display'}
+        self.registries: set[int] = set()
+        self.callbacks: set[int] = set()
+        self.dead_regions: set[int] = set()
+        self.owned: set[int] = set()
+        self.free: deque[int] = deque()
+        self.retiring: set[int] = set()
+        self.registry = 0
+        self.manager = 0
+        self.manager_global = 0
+        self.advertised = False
+        self.advertised_name = 0
+        self.capabilities = 0
+        self.compositor = 0
+        self.xdg_surfaces: dict[int, int] = {}
+        self.toplevels: set[int] = set()
+        self.effects: dict[int, int] = {}  # wl_surface -> owned effect
+        self.native_client = False
+
+    def send(self, object_id, opcode, payload=b'', trace='') -> None:
+        self.inject(message(object_id, opcode, payload), trace)
+
+    def wants_blur(self) -> bool:
+        return self.enabled and not self.native_client
+
+    def wants_shadow(self) -> bool:
+        return self.shadow_enabled and not self.native_shadow and bool(self.shadow_global)
+
+    def need_ids(self) -> int:
+        # Registry, managers, one temporary region/pool, eight shared buffers,
+        # then one blur and one shadow per live toplevel. Never reserve gaps.
+        blur = self.wants_blur() and self.advertised
+        shadow = self.wants_shadow()
+        base = 1 + int(blur) + int(shadow) * 10 + int(blur or shadow)
+        return min(MAX_OWN_IDS, base + max(1, len(self.toplevels)) * (int(blur) * (1 + int(self.corner_radius > 0)) + int(shadow)))
+
+    def retire(self, object_id: int, opcode: int = 0, trace: str = '') -> None:
+        self.send(object_id, opcode, trace=trace)
+        self.retiring.add(object_id)
+
+    def progress(self) -> None:
+        if not self.wants_blur() and not self.wants_shadow():
+            return
+        if not self.registry and self.free:
+            self.registry = self.free.popleft()
+            self.send(1, 1, words(self.registry),
+                      f'wl_display@1.get_registry(new id wl_registry@{self.registry})')
+        if self.registry and self.manager_global and not self.manager and self.free and self.wants_blur():
+            self.manager = self.free.popleft()
+            self.send(self.registry, 0,
+                      words(self.manager_global) + string('ext_background_effect_manager_v1') + words(1, self.manager),
+                      f'wl_registry@{self.registry}.bind(ext_background_effect_manager_v1@{self.manager}, version=1)')
+        if self.registry and self.wants_shadow():
+            for attribute, global_name, interface, version in (
+                    ('shadow_manager', self.shadow_global, 'org_kde_kwin_shadow_manager', 2),
+                    ('shm', self.shm_global, 'wl_shm', 1)):
+                if global_name and not getattr(self, attribute) and self.free:
+                    object_id = self.free.popleft()
+                    setattr(self, attribute, object_id)
+                    self.send(self.registry, 0, words(global_name) + string(interface) + words(version, object_id),
+                              f'wl_registry@{self.registry}.bind({interface}@{object_id}, version={version})')
+            self.prepare_shadow_buffers()
+        for surface in sorted(self.toplevels):
+            if self.surface_title and surface not in self.selected:
+                continue
+            if self.wants_blur() and self.manager and self.compositor and self.capabilities & 1:
+                self.update_region(surface)
+            if surface not in self.blocked and self.wants_shadow() and self.shadow_buffers:
+                self.create_shadow(surface)
+        if len(self.owned) == MAX_OWN_IDS and not self.budget_warned:
+            self.budget_warned = True
+            self.log('WARNING: appearance ID budget reached; additional windows may lack effects')
+
+    def update_region(self, surface: int) -> None:
+        geometry = self.geometry.get(surface)
+        radius = 0 if surface in self.blocked else self.corner_radius
+        # Unknown dimensions with rounded alpha must stay unblurred, not leak
+        # a full rectangular blur outside the transparent corners.
+        if geometry is None:
+            if radius:
+                return
+            geometry = (0, 0, 32767, 32767)
+        signature = (*geometry, radius)
+        if self.applied_regions.get(surface) == signature:
+            return
+        effect = self.effects.get(surface)
+        region = self.regions.get(surface)
+        if len(self.free) < int(not region) + int(not effect):
+            return
+        fresh_region = not region
+        if not region:
+            region = self.free.popleft()
+            if self.corner_radius:
+                self.regions[surface] = region
+        if not effect:
+            effect = self.free.popleft()
+            self.effects[surface] = effect
+            self.send(self.manager, 1, words(effect, surface),
+                      f'ext_background_effect_manager_v1@{self.manager}.get_background_effect(new id ext_background_effect_surface_v1@{effect}, wl_surface@{surface})')
+        if fresh_region:
+            self.send(self.compositor, 1, words(region),
+                      f'wl_compositor@{self.compositor}.create_region(new id wl_region@{region})')
+        else:
+            previous = self.applied_regions[surface]
+            self.send(region, 2, struct.pack('=iiii', *previous[:4]),
+                      f'wl_region@{region}.subtract(previous bounds)')
+        for x, y, width, height in rounded_rectangles(*geometry, radius):
+            self.send(region, 1, struct.pack('=iiii', x, y, width, height),
+                      f'wl_region@{region}.add({x}, {y}, {width}, {height})')
+        self.send(effect, 1, words(region),
+                  f'ext_background_effect_surface_v1@{effect}.set_blur_region(wl_region@{region})')
+        if not self.corner_radius:
+            self.retire(region, trace=f'wl_region@{region}.destroy()')
+        self.applied_regions[surface] = signature
+
+    def prepare_shadow_buffers(self) -> None:
+        if (self.shadow_buffers or not self.toplevels or not self.shm or not self.shadow_manager or
+                len(self.free) < 9 or self.inject_fds is None or not self.may_inject_fds()):
+            return
+        pixels, tiles = shadow_tiles()
+        fd = os.memfd_create('dsh-wayland-shadow', os.MFD_CLOEXEC)
+        try:
+            os.ftruncate(fd, len(pixels))
+            position = 0
+            while position < len(pixels):
+                position += os.pwrite(fd, pixels[position:], position)
+            pool = self.free.popleft()
+            # The queue takes ownership of the descriptor, including on failure.
+            transfer_fd, fd = fd, -1
+            self.inject_fds(message(self.shm, 0, words(pool, len(pixels))), [transfer_fd],
+                            f'wl_shm@{self.shm}.create_pool(new id wl_shm_pool@{pool}, fd, size={len(pixels)})')
+            for offset, width, height in tiles:
+                buffer = self.free.popleft()
+                self.shadow_buffers.append(buffer)
+                self.send(pool, 0, words(buffer, offset, width, height, width * 4, 0),
+                          f'wl_shm_pool@{pool}.create_buffer(new id wl_buffer@{buffer}, {width}x{height}, ARGB8888)')
+            self.retire(pool, 1, f'wl_shm_pool@{pool}.destroy()')
+        finally:
+            if fd >= 0:
+                os.close(fd)
+
+    def create_shadow(self, surface: int) -> None:
+        if surface in self.shadows or not self.free:
+            return
+        shadow = self.free.popleft()
+        self.shadows[surface] = shadow
+        self.send(self.shadow_manager, 0, words(shadow, surface),
+                  f'org_kde_kwin_shadow_manager@{self.shadow_manager}.create(org_kde_kwin_shadow@{shadow}, wl_surface@{surface})')
+        for opcode, buffer in enumerate(self.shadow_buffers, 1):
+            self.send(shadow, opcode, words(buffer), f'org_kde_kwin_shadow@{shadow}.attach_tile({opcode}, wl_buffer@{buffer})')
+        for opcode in range(9, 13):
+            self.send(shadow, opcode, words(24 * 256))
+        self.send(shadow, 0, trace=f'org_kde_kwin_shadow@{shadow}.commit()')
+
+    def destroy_shadow(self, surface: int) -> None:
+        shadow = self.shadows.pop(surface, 0)
+        if shadow:
+            self.send(self.shadow_manager, 1, words(surface),
+                      f'org_kde_kwin_shadow_manager@{self.shadow_manager}.unset(wl_surface@{surface})')
+            self.retire(shadow, 13, f'org_kde_kwin_shadow@{shadow}.destroy()')
+
+    def destroy_surface(self, surface: int) -> None:
+        self.destroy_effect(surface)
+        self.destroy_shadow(surface)
+        self.toplevels.discard(surface)
+        self.geometry.pop(surface, None)
+        self.selected.discard(surface)
+        self.blocked.discard(surface)
+        self.applied_regions.pop(surface, None)
+        self.pending_config.pop(surface, None)
+        self.toplevel_surfaces = {key: value for key, value in self.toplevel_surfaces.items() if value != surface}
+        if not self.toplevels:
+            for buffer in self.shadow_buffers:
+                self.retire(buffer, trace=f'wl_buffer@{buffer}.destroy()')
+            self.shadow_buffers.clear()
+
+    def destroy_effect(self, surface: int) -> None:
+        region = self.regions.pop(surface, 0)
+        if region:
+            self.retire(region, trace=f'wl_region@{region}.destroy()')
+        effect = self.effects.pop(surface, 0)
+        if effect:
+            self.send(effect, 0, trace=f'ext_background_effect_surface_v1@{effect}.destroy()')
+            self.retiring.add(effect)
+
+    def client(self, data: bytes) -> None:
+        object_id, size_opcode = HEADER.unpack_from(data)
+        opcode, payload = size_opcode & 0xffff, data[8:]
+        interface = self.objects.get(object_id, '')
+        # FDs may precede their consuming message, even across recvmsg batches.
+        # Unknown FD-bearing extensions conservatively delay shadow allocation;
+        # forwarding is unchanged and existing blur/shadow objects remain valid.
+        fd_request = (interface, opcode) in {
+            ('wl_shm', 0), ('zwp_linux_buffer_params_v1', 1),
+            ('zwp_linux_surface_synchronization_v1', 1),
+            ('wp_linux_drm_syncobj_manager_v1', 2),
+            ('wl_data_offer', 1), ('zwp_primary_selection_offer_v1', 0),
+            ('zwlr_data_control_offer_v1', 0), ('ext_data_control_offer_v1', 0),
+        }
+        self.expected_client_fds += int(fd_request)
+        constructors = {
+            ('wl_shm', 0): 'wl_shm_pool',
+            ('zwp_linux_dmabuf_v1', 1): 'zwp_linux_buffer_params_v1',
+            ('zwp_linux_explicit_synchronization_v1', 1): 'zwp_linux_surface_synchronization_v1',
+            ('wl_data_device_manager', 1): 'wl_data_device',
+            ('zwp_primary_selection_device_manager_v1', 1): 'zwp_primary_selection_device_v1',
+            ('zwlr_data_control_manager_v1', 1): 'zwlr_data_control_device_v1',
+            ('ext_data_control_manager_v1', 1): 'ext_data_control_device_v1',
+        }
+        if (interface, opcode) in constructors:
+            self.objects[U32.unpack_from(payload)[0]] = constructors[(interface, opcode)]
+        if object_id in self.owned:
+            raise ValueError('client attempted to reuse a retained object ID')
+        if interface == 'wl_display' and opcode in (0, 1):
+            new_id = U32.unpack_from(payload)[0]
+            if opcode == 0:
+                self.objects[new_id] = 'wl_callback'
+                self.callbacks.add(new_id)
+            else:
+                self.objects[new_id] = 'wl_registry'
+                self.registries.add(new_id)
+        elif interface == 'wl_registry' and opcode == 0:
+            name, offset = read_string(payload, 4)
+            new_id = U32.unpack_from(payload, offset + 4)[0]
+            self.objects[new_id] = name
+            if name == 'wl_compositor':
+                self.compositor = new_id
+            elif name in ('ext_background_effect_manager_v1', 'org_kde_kwin_blur_manager'):
+                # A protocol-aware client owns policy. Do not create duplicates.
+                self.native_client = True
+                for surface in list(self.effects):
+                    self.destroy_effect(surface)
+                self.log('client supports background effects; blur injection disabled')
+            elif name == 'org_kde_kwin_shadow_manager':
+                self.native_shadow = True
+                for surface in list(self.shadows):
+                    self.destroy_shadow(surface)
+                self.log('client supports KDE shadows; shadow injection disabled')
+        elif interface == 'wl_compositor' and opcode in (0, 1):
+            self.objects[U32.unpack_from(payload)[0]] = 'wl_surface' if opcode == 0 else 'wl_region'
+        elif interface == 'wl_region' and opcode == 0:
+            self.dead_regions.add(object_id)
+        elif interface == 'wl_surface':
+            if opcode == 3:  # frame(new_id callback)
+                new_id = U32.unpack_from(payload)[0]
+                self.objects[new_id] = 'wl_callback'
+                self.callbacks.add(new_id)
+            elif opcode == 0:
+                self.destroy_surface(object_id)
+                self.xdg_surfaces = {xdg: surface for xdg, surface in self.xdg_surfaces.items() if surface != object_id}
+        elif interface == 'xdg_wm_base' and opcode == 2:
+            new_id, surface = struct.unpack_from('=II', payload)
+            self.objects[new_id] = 'xdg_surface'
+            self.xdg_surfaces[new_id] = surface
+        elif interface == 'xdg_surface':
+            if opcode == 1:
+                surface = self.xdg_surfaces.get(object_id)
+                if surface:
+                    self.toplevels.add(surface)
+                toplevel = U32.unpack_from(payload)[0]
+                self.objects[toplevel] = 'xdg_toplevel'
+                if surface:
+                    self.toplevel_surfaces[toplevel] = surface
+            elif opcode == 0:
+                surface = self.xdg_surfaces.pop(object_id, None)
+                if surface:
+                    self.destroy_surface(surface)
+                self.configures.pop(object_id, None)
+            elif opcode == 3:  # set_window_geometry, in surface-local coordinates
+                surface = self.xdg_surfaces.get(object_id)
+                geometry = struct.unpack_from('=iiii', payload)
+                if surface and 0 < geometry[2] <= 32767 and 0 < geometry[3] <= 32767:
+                    self.geometry[surface] = geometry
+            elif opcode == 4:  # ack_configure; never apply unacknowledged state
+                surface = self.xdg_surfaces.get(object_id)
+                serial = U32.unpack_from(payload)[0]
+                configs = self.configures.get(object_id, {})
+                config = configs.get(serial)
+                if serial in configs:
+                    for acknowledged in list(configs):
+                        del configs[acknowledged]
+                        if acknowledged == serial:
+                            break
+                if surface and config:
+                    width, height, blocked = config
+                    if blocked:
+                        self.blocked.add(surface)
+                        self.destroy_shadow(surface)
+                    else:
+                        self.blocked.discard(surface)
+                    if width and height:
+                        self.geometry[surface] = (0, 0, width, height)
+        elif interface == 'xdg_toplevel':
+            if opcode == 0:
+                surface = self.toplevel_surfaces.pop(object_id, None)
+                if surface:
+                    self.destroy_surface(surface)
+            elif opcode == 2 and self.surface_title:
+                title, _ = read_string(payload, 0)
+                surface = self.toplevel_surfaces.get(object_id)
+                if surface and title == self.surface_title:
+                    # Session-driven document title changes must not deselect
+                    # a window already identified by its initial app title.
+                    self.selected.add(surface)
+        self.progress()  # before forwarding the client's next normal commit
+
+    def server(self, data: bytes) -> bool:
+        object_id, size_opcode = HEADER.unpack_from(data)
+        opcode, payload = size_opcode & 0xffff, data[8:]
+        if object_id == 1 and opcode == 0:  # wl_display.error; never hide errors
+            failed_id, code = struct.unpack_from('=II', payload)
+            self.log(f'ERROR: wl_display.error(object_id={failed_id}, code={code}, relay_owned={failed_id in self.owned})')
+        elif object_id == 1 and opcode == 1:  # wl_display.delete_id
+            old_id = U32.unpack_from(payload)[0]
+            if old_id in self.owned:
+                if old_id in self.retiring:
+                    self.retiring.remove(old_id)
+                    self.free.append(old_id)
+                self.progress()
+                return False
+            reclaimable = old_id in self.callbacks or old_id in self.dead_regions
+            self.callbacks.discard(old_id)
+            self.dead_regions.discard(old_id)
+            self.objects.pop(old_id, None)
+            self.registries.discard(old_id)
+            if (((self.wants_blur() and self.advertised) or self.wants_shadow())
+                    and reclaimable and 1 < old_id < SERVER_ID_START
+                    and len(self.owned) < self.need_ids()):
+                self.owned.add(old_id)
+                self.free.append(old_id)
+                self.log(f'retained deleted client ID {old_id} ({len(self.owned)}/{self.need_ids()})')
+                self.progress()
+                return False
+        elif object_id in self.registries or (self.registry and object_id == self.registry):
+            if opcode == 0:
+                name = U32.unpack_from(payload)[0]
+                interface, offset = read_string(payload, 4)
+                version = U32.unpack_from(payload, offset)[0]
+                if interface == 'org_kde_kwin_shadow_manager' and version >= 2:
+                    self.shadow_global = name
+                elif interface == 'wl_shm' and version >= 1:
+                    self.shm_global = name
+                if interface == 'ext_background_effect_manager_v1' and version >= 1:
+                    self.advertised = True
+                    self.advertised_name = name
+                    if object_id == self.registry:
+                        self.manager_global = name
+                        self.progress()
+            elif opcode == 1:
+                removed = U32.unpack_from(payload)[0]
+                if removed == self.advertised_name:
+                    self.advertised = False
+                    self.manager_global = 0
+                    self.capabilities = 0
+                if removed == self.shadow_global:
+                    self.shadow_global = 0
+                if removed == self.shm_global:
+                    self.shm_global = 0
+            return object_id != self.registry
+        elif self.manager and object_id == self.manager:
+            if opcode == 0:
+                self.capabilities = U32.unpack_from(payload)[0]
+                self.log(f'ext_background_effect_manager_v1@{self.manager}.capabilities({self.capabilities})')
+                self.progress()
+            return False
+        elif self.objects.get(object_id) == 'xdg_toplevel' and opcode == 0:
+            width, height, length = struct.unpack_from('=iiI', payload)
+            if length % 4 or 12 + length > len(payload):
+                raise ValueError('invalid xdg_toplevel states')
+            states = struct.unpack_from('=' + 'I' * (length // 4), payload, 12)
+            surface = self.toplevel_surfaces.get(object_id)
+            if surface:
+                self.pending_config[surface] = (min(32767, max(0, width)), min(32767, max(0, height)), bool({1, 2}.intersection(states)))
+        elif self.objects.get(object_id) == 'xdg_surface' and opcode == 0:
+            surface = self.xdg_surfaces.get(object_id)
+            if surface in self.pending_config:
+                configs = self.configures.setdefault(object_id, {})
+                if len(configs) >= 64:
+                    raise ValueError('too many outstanding xdg configure serials')
+                configs[U32.unpack_from(payload)[0]] = self.pending_config[surface]
+        elif opcode == 0 and self.objects.get(object_id) in (
+                'wl_data_device', 'zwp_primary_selection_device_v1',
+                'zwlr_data_control_device_v1', 'ext_data_control_device_v1'):
+            offer_interface = {
+                'wl_data_device': 'wl_data_offer',
+                'zwp_primary_selection_device_v1': 'zwp_primary_selection_offer_v1',
+                'zwlr_data_control_device_v1': 'zwlr_data_control_offer_v1',
+                'ext_data_control_device_v1': 'ext_data_control_offer_v1',
+            }[self.objects[object_id]]
+            self.objects[U32.unpack_from(payload)[0]] = offer_interface
+        elif object_id in self.owned:
+            return False
+        return True
+
