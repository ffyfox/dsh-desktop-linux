+    document.documentElement.setAttribute('data-dsh-titlebar-style', captionStyle)
+    style = document.createElement('style')
+    style.textContent = `
+      html[data-dsh-kde-glass-chrome] { clip-path:inset(0 round ${radius}px); background:transparent !important; min-height:100%; }
+      html[data-dsh-kde-glass-chrome][data-kde-glass-maximized], html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] { clip-path:inset(0 round 0px); }
+      html[data-dsh-titlebar-style=macos] [data-shell-leading] { left:88px !important; }
+      html[data-dsh-titlebar-style=macos] :is([data-sidebar-collapsed],[data-sidebar-drawer]) { --dsh-frame-leading-clearance:160px !important; }
+      html[data-dsh-titlebar-style=fusion] [data-shell-leading], html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] [data-shell-leading] { left:12px !important; }
+      html[data-dsh-titlebar-style=fusion] :is([data-sidebar-collapsed],[data-sidebar-drawer]), html[data-dsh-kde-glass-chrome][data-kde-glass-fullscreen] :is([data-sidebar-collapsed],[data-sidebar-drawer]) { --dsh-frame-leading-clearance:84px !important; }
+      html[data-dsh-titlebar-style=fusion] header[data-dsh-caption-clearance] { padding-right:172px !important; }
+      html[data-dsh-titlebar-style=fusion] [data-dockkit-strip][data-dsh-caption-clearance] { padding-right:150px !important; }
+      /* Blended keeps the upstream brand/toggle nodes and their event ownership in one row. */
+      html[data-dsh-titlebar-style=fusion] [class*="sidebarCol"] > div > [class*="_root"] { position:relative; }
+      html[data-dsh-titlebar-style=fusion] [class*="sidebarCol"] [data-window-drag]:has(> [data-sidebar-toggle]) { height:0; min-height:0; margin:0; padding:0; }
+      html[data-dsh-titlebar-style=fusion] [class*="sidebarCol"] [data-window-drag] > [data-sidebar-toggle] { position:absolute; top:11px; right:12px; z-index:31; }
+      html[data-dsh-titlebar-style=fusion] [class*="sidebarCol"] [data-window-drag]:has(> [data-sidebar-toggle]) + [data-window-drag] { height:40px; margin-top:0; padding:0 40px 0 8px; }
