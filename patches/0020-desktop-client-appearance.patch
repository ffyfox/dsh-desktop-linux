+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'">
+    <title></title>
+    <link rel="stylesheet" href="client-settings.css">
+    <script src="client-settings.js" defer></script>
+  </head>
+  <body>
+    <header class="page-header">
+      <h1 data-message="title"></h1>
+      <p data-message="subtitle"></p>
+    </header>
+    <main>
+      <p id="loading" role="status" data-message="loading"></p>
+      <form id="appearance-form" hidden>
+        <fieldset id="preferences">
+          <section class="group" aria-labelledby="window-heading">
+            <h2 id="window-heading" data-message="windowGroup"></h2>
+            <div class="field">
+              <div class="field-heading">
+                <label for="titlebar-style" data-message="titlebarStyle"></label>
+                <select id="titlebar-style" required aria-describedby="titlebar-help">
+                  <option value="macos" data-message="titlebarMacos"></option>
+                  <option value="windows" data-message="titlebarWindows"></option>
+                  <option value="fusion" data-message="titlebarFusion"></option>
+                </select>
+              </div>
+              <p id="titlebar-help" class="help" data-message="titlebarHelp"></p>
+            </div>
+            <div class="field">
+              <div class="field-heading">
+                <label for="corner-radius" data-message="cornerRadius"></label>
+                <div class="number-unit"><input id="corner-radius" type="number" min="0" max="32" step="1" required aria-describedby="corner-help"><span aria-hidden="true">px</span></div>
+              </div>
+              <input id="corner-radius-range" type="range" min="0" max="32" step="1" aria-describedby="corner-help">
+              <p id="corner-help" class="help" data-message="cornerHelp"></p>
+            </div>
+            <label class="toggle-row" for="system-shadow">
+              <span><span class="field-label" data-message="shadow"></span><span id="shadow-help" class="help" data-message="shadowHelp"></span></span>
+              <input id="system-shadow" type="checkbox" aria-describedby="shadow-help">
+            </label>
+          </section>
+          <section class="group" aria-labelledby="sidebar-heading">
+            <h2 id="sidebar-heading" data-message="sidebarGroup"></h2>
+            <label class="toggle-row" for="sidebar-glass">
+              <span><span class="field-label" data-message="glass"></span><span id="glass-help" class="help" data-message="glassHelp"></span></span>
+              <input id="sidebar-glass" type="checkbox" aria-describedby="glass-help">
+            </label>
+            <div class="field" id="transparency-field">
+              <div class="field-heading">
+                <label for="sidebar-transparency" data-message="transparency"></label>
+                <div class="number-unit"><input id="sidebar-transparency" type="number" min="0" max="100" step="1" required aria-describedby="transparency-help"><span aria-hidden="true">%</span></div>
+              </div>
+              <input id="sidebar-transparency-range" type="range" min="0" max="100" step="1" aria-describedby="transparency-help">
+              <div class="range-labels" aria-hidden="true"><span data-message="opaque"></span><span data-message="transparent"></span></div>
+              <p id="transparency-help" class="help" data-message="transparencyHelp"></p>
+            </div>
+          </section>
+          <details class="group advanced">
+            <summary data-message="advanced"></summary>
+            <label class="toggle-row" for="frameless">
+              <span><span class="field-label" data-message="frameless"></span><span id="frameless-help" class="help" data-message="framelessHelp"></span></span>
+              <input id="frameless" type="checkbox" aria-describedby="frameless-help">
+            </label>
+            <label class="toggle-row" for="wayland-blur">
+              <span><span class="field-label" data-message="blur"></span><span id="blur-help" class="help" data-message="blurHelp"></span></span>
+              <input id="wayland-blur" type="checkbox" aria-describedby="blur-help">
+            </label>
+            <p class="help separated" data-message="environmentHelp"></p>
+            <p class="help" data-message="privacyHelp"></p>
+          </details>
+        </fieldset>
+        <section class="snapshot" aria-label="" id="snapshot">
+          <p class="restart-help" data-message="restartHelp"></p>
+          <dl>
+            <div><dt data-message="runningLabel"></dt><dd id="current-summary"></dd></div>
+            <div><dt data-message="savedLabel"></dt><dd id="saved-summary"></dd></div>
+          </dl>
+        </section>
+      </form>
+      <div class="feedback" aria-live="polite" aria-atomic="true">
+        <p id="status" role="status"></p>
+        <p id="error" role="alert" hidden></p>
+        <button id="retry" type="button" data-message="retry" hidden></button>
+      </div>
+    </main>
+    <footer>
+      <button id="restore" type="button" data-message="restore" disabled></button>
+      <div class="save-actions">
+        <button id="save" type="submit" form="appearance-form" data-message="save" disabled></button>
+        <button id="save-restart" class="primary" type="button" data-message="saveRestart" disabled></button>
+      </div>
+    </footer>
+  </body>
+</html>
diff --git a/apps/desktop/renderer/client-settings.js b/apps/desktop/renderer/client-settings.js
new file mode 100644
index 00000000..ab775183
--- /dev/null
+++ b/apps/desktop/renderer/client-settings.js
@@ -0,0 +1,219 @@
+/* The isolated document renders only appearance values and renderer-owned localized copy. */
+(() => {
+  'use strict'
+
+  const api = window.dshClientSettings
+  // This renderer-owned fallback remains available if the preload cannot reach the main process.
+  const bootstrapMessages = {
+    en: { title: 'Client appearance', unavailable: 'Client settings are unavailable. Close this window and open client appearance again.' },
+    zhCN: { title: '客户端外观', unavailable: '客户端设置暂不可用，请关闭此窗口后重新打开客户端外观' },
+  }
+  const form = document.getElementById('appearance-form')
+  const preferences = document.getElementById('preferences')
+  const radius = document.getElementById('corner-radius')
+  const radiusRange = document.getElementById('corner-radius-range')
+  const transparency = document.getElementById('sidebar-transparency')
+  const transparencyRange = document.getElementById('sidebar-transparency-range')
+  const shadow = document.getElementById('system-shadow')
+  const glass = document.getElementById('sidebar-glass')
+  const frameless = document.getElementById('frameless')
+  const blur = document.getElementById('wayland-blur')
+  const titlebar = document.getElementById('titlebar-style')
+  const restore = document.getElementById('restore')
+  const save = document.getElementById('save')
+  const saveRestart = document.getElementById('save-restart')
+  const retry = document.getElementById('retry')
+  const status = document.getElementById('status')
+  const error = document.getElementById('error')
+  const loading = document.getElementById('loading')
+  let messages
+  let snapshot
+  let pending = false
+
+  function localize(reply) {
+    messages = reply.messages
+    document.documentElement.lang = reply.locale
+    document.title = messages.title
+    for (const element of document.querySelectorAll('[data-message]')) element.textContent = messages[element.dataset.message]
+    for (const element of [radius, radiusRange]) element.setAttribute('aria-label', messages.cornerValue)
+    for (const element of [transparency, transparencyRange]) element.setAttribute('aria-label', messages.transparencyValue)
+    document.getElementById('snapshot').setAttribute('aria-label', messages.restartHelp)
+  }
+
+  function clearError() { error.hidden = true; error.textContent = ''; retry.hidden = true }
+
+  function showError(problem) {
+    const keys = {
+      json: 'errorJson', document: 'errorDocument', version: 'errorVersion', fields: 'errorFields', read: 'errorRead',
+      write: 'errorWrite', resources: 'errorResources', busy: 'errorBusy', closed: 'errorClosed', restart: 'errorRestart',
+    }
+    error.textContent = messages[keys[problem.kind] || 'errorUnexpected']
+    error.hidden = false
+    status.textContent = ''
+  }
+
+  function setPending(value, action) {
+    pending = value
+    preferences.disabled = value || snapshot === undefined
+    for (const button of [restore, save, saveRestart]) button.disabled = value || snapshot === undefined
+    retry.disabled = value
+    form.setAttribute('aria-busy', String(value))
+    save.removeAttribute('aria-busy')
+    saveRestart.removeAttribute('aria-busy')
+    if (messages === undefined) return
+    save.textContent = messages.save
+    saveRestart.textContent = messages.saveRestart
+    if (value && action !== 'load') {
+      const button = action === 'save' ? save : saveRestart
+      button.setAttribute('aria-busy', 'true')
+      button.textContent = action === 'restart' ? messages.restarting : messages.saving
+      status.textContent = action === 'restart' ? messages.restarting : messages.saving
+    }
+  }
+
+  function numberValid(input, maximum, message) {
+    const number = input.valueAsNumber
+    const valid = input.value !== '' && Number.isInteger(number) && number >= 0 && number <= maximum
+    input.setCustomValidity(valid ? '' : message)
+    input.setAttribute('aria-invalid', String(!valid))
+    return valid
+  }
+
+  function validate() {
+    const validRadius = numberValid(radius, 32, messages.radiusInvalid)
+    const validTransparency = numberValid(transparency, 100, messages.transparencyInvalid)
+    const validTitlebar = titlebar.value === 'macos' || titlebar.value === 'windows' || titlebar.value === 'fusion'
+    titlebar.setCustomValidity(validTitlebar ? '' : messages.titlebarInvalid)
+    titlebar.setAttribute('aria-invalid', String(!validTitlebar))
+    return validRadius && validTransparency && validTitlebar
+  }
+
+  function formValue() {
+    return {
+      frameless: frameless.checked, cornerRadius: radius.valueAsNumber, systemShadow: shadow.checked,
+      sidebarGlass: glass.checked, sidebarOpacity: 100 - transparency.valueAsNumber, waylandBlur: blur.checked,
+      titlebarStyle: titlebar.value,
+    }
+  }
+
+  function equal(left, right) {
+    return left.frameless === right.frameless && left.cornerRadius === right.cornerRadius && left.systemShadow === right.systemShadow
+      && left.sidebarGlass === right.sidebarGlass && left.sidebarOpacity === right.sidebarOpacity && left.waylandBlur === right.waylandBlur
+      && left.titlebarStyle === right.titlebarStyle
+  }
+
+  function setForm(value) {
+    radius.value = String(value.cornerRadius)
+    radiusRange.value = radius.value
+    transparency.value = String(100 - value.sidebarOpacity)
+    transparencyRange.value = transparency.value
+    shadow.checked = value.systemShadow
+    glass.checked = value.sidebarGlass
+    frameless.checked = value.frameless
+    blur.checked = value.waylandBlur
+    titlebar.value = value.titlebarStyle
+    validate()
+  }
+
+  function summary(value) {
+    const replacements = {
+      style: { macos: messages.titlebarMacos, windows: messages.titlebarWindows, fusion: messages.titlebarFusion }[value.titlebarStyle],
+      radius: value.cornerRadius, transparency: 100 - value.sidebarOpacity,
+      shadow: value.systemShadow ? messages.on : messages.off, glass: value.sidebarGlass ? messages.on : messages.off,
+      frameless: value.frameless ? messages.on : messages.off, blur: value.waylandBlur ? messages.on : messages.off,
+    }
+    return messages.snapshotTemplate.replace(/\{(style|radius|transparency|shadow|glass|frameless|blur)\}/gu, (_match, key) => String(replacements[key]))
+  }
+
+  function showSummaries() {
+    document.getElementById('current-summary').textContent = summary(snapshot.current)
+    document.getElementById('saved-summary').textContent = summary(snapshot.saved)
+  }
+
+  function edited() {
+    if (snapshot === undefined || pending) return
+    const valid = validate()
+    status.textContent = !valid || !equal(formValue(), snapshot.saved) ? messages.edited
+      : snapshot.restartRequired ? messages.savedRestart : messages.unchanged
+  }
+
+  function bindPair(number, range) {
+    number.addEventListener('input', () => {
+      if (Number.isInteger(number.valueAsNumber) && number.valueAsNumber >= Number(number.min) && number.valueAsNumber <= Number(number.max)) {
+        range.value = number.value
+      }
+      edited()
+    })
+    range.addEventListener('input', () => { number.value = range.value; edited() })
+  }
+
+  async function load() {
+    if (pending) return
+    setPending(true, 'load')
+    try {
+      const reply = await api.get()
+      localize(reply)
+      clearError()
+      if (reply.kind === 'error') {
+        showError(reply.problem)
+        retry.hidden = false
+        return
+      }
+      snapshot = reply.value
+      setForm(snapshot.saved)
+      showSummaries()
+      form.hidden = false
+      status.textContent = snapshot.restartRequired ? messages.savedRestart : messages.unchanged
+    } catch (_failure) {
+      if (messages !== undefined) { showError({ kind: 'unexpected' }); retry.hidden = false }
+      else {
+        const chinese = /^zh(?:[-_]|$)/iu.test(navigator.language)
+        const copy = bootstrapMessages[chinese ? 'zhCN' : 'en']
+        document.documentElement.lang = chinese ? 'zh-CN' : 'en'
+        document.title = copy.title
+        document.querySelector('h1').textContent = copy.title
+        document.querySelector('footer').hidden = true
+        error.textContent = copy.unavailable
+        error.hidden = false
+      }
+    } finally {
+      loading.hidden = true
+      setPending(false)
+    }
+  }
+
+  async function submit(restart) {
+    if (pending || snapshot === undefined) return
+    if (!validate()) { form.reportValidity(); return }
+    clearError()
+    setPending(true, restart ? 'save-restart' : 'save')
+    try {
+      const reply = await api.save(formValue())
+      if (reply.kind === 'error') { showError(reply.problem); return }
+      snapshot = reply.value
+      showSummaries()
+      status.textContent = snapshot.restartRequired ? messages.savedRestart : messages.saved
+      if (!restart) return
+      setPending(true, 'restart')
+      const result = await api.restart()
+      if (result.kind === 'error') showError(result.problem)
+      else status.textContent = result.value.restarted ? messages.restarting : messages.restartCancelled
+    } catch (_failure) {
+      showError({ kind: 'unexpected' })
+    } finally { setPending(false) }
+  }
+
+  bindPair(radius, radiusRange)
+  bindPair(transparency, transparencyRange)
+  for (const control of [shadow, glass, frameless, blur, titlebar]) control.addEventListener('change', edited)
+  form.addEventListener('submit', event => { event.preventDefault(); void submit(false) })
+  saveRestart.addEventListener('click', () => { void submit(true) })
+  retry.addEventListener('click', () => { void load() })
+  restore.addEventListener('click', () => {
+    if (pending || snapshot === undefined) return
+    clearError()
+    setForm(snapshot.defaults)
+    status.textContent = messages.defaultsRestored
+  })
+  void load()
+})()
diff --git a/apps/desktop/renderer/client-settings/messages.json b/apps/desktop/renderer/client-settings/messages.json
