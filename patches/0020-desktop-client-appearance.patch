+import { EventEmitter } from 'node:events'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { BrowserWindow, IpcMainEvent } from 'electron'
+import { installLinuxWindowChrome, installLinuxCornerRadius } from '../src/linux-window-chrome.ts'
+import { LINUX_CHROME_IPC } from '../src/linux-chrome-ipc.ts'
+
+const native = vi.hoisted(() => ({ on: vi.fn(), removeListener: vi.fn() }))
+vi.mock('electron', () => ({ ipcMain: native }))
+afterEach(() => { vi.clearAllMocks() })
+
+function owner() {
+  const contents = Object.assign(new EventEmitter(), { mainFrame: { url: 'dsh-app://app/' }, send: vi.fn() })
+  const fake = Object.assign(new EventEmitter(), {
+    webContents: contents, isDestroyed: () => false, isMaximized: vi.fn(() => false), isFullScreen: vi.fn(() => false), isFocused: () => true,
+    close: vi.fn(), minimize: vi.fn(), maximize: vi.fn(), unmaximize: vi.fn(), setFullScreen: vi.fn(), contentView: { setBorderRadius: vi.fn() },
+  })
+  // Electron native objects are replaced with the exact methods under test.
+  const window = fake as typeof fake & BrowserWindow
+  return { window, contents, event: { sender: contents, senderFrame: contents.mainFrame } as IpcMainEvent & { sender: typeof contents; senderFrame: typeof contents.mainFrame } }
+}
+
+it('allows only the owning app main frame to send the three native-window actions', () => {
+  const { window, contents, event } = owner()
+  installLinuxWindowChrome(window)
+  const action = native.on.mock.calls[0]![1] as (event: IpcMainEvent, action: unknown) => void
+  action({ ...event, sender: {} } as IpcMainEvent, 'close')
+  const foreignFrame: NonNullable<IpcMainEvent['senderFrame']> = Object.create(event.senderFrame)
+  action({ ...event, senderFrame: foreignFrame }, 'close')
+  contents.mainFrame.url = 'https://untrusted.example/'
+  action(event, 'close')
+  contents.mainFrame.url = 'dsh-app://app/'
+  action(event, 'exec'); action(event, { action: 'close' })
+  expect(window.close).not.toHaveBeenCalled()
+  action(event, 'close'); action(event, 'minimize'); action(event, 'maximize')
+  expect(window.close).toHaveBeenCalledOnce(); expect(window.minimize).toHaveBeenCalledOnce(); expect(window.maximize).toHaveBeenCalledOnce()
+  window.isMaximized.mockReturnValue(true)
+  action(event, 'maximize'); expect(window.unmaximize).toHaveBeenCalledOnce()
+  window.isFullScreen.mockReturnValue(true)
+  action(event, 'maximize'); expect(window.setFullScreen).toHaveBeenCalledWith(false)
+  window.emit('closed')
+  expect(native.removeListener).toHaveBeenCalledWith(LINUX_CHROME_IPC.action, action)
+})
+
+it('publishes native state on reload and disables the configured corner radius in fullscreen or maximized state', () => {
+  const { window, contents } = owner()
+  installLinuxWindowChrome(window)
+  installLinuxCornerRadius(window, 24)
+  expect(window.contentView.setBorderRadius).toHaveBeenLastCalledWith(24)
+  window.isMaximized.mockReturnValue(true); window.emit('maximize')
+  expect(window.contentView.setBorderRadius).toHaveBeenLastCalledWith(0)
+  expect(contents.send).toHaveBeenLastCalledWith(LINUX_CHROME_IPC.state, { maximized: true, fullscreen: false, focused: true })
+  window.isMaximized.mockReturnValue(false); window.emit('unmaximize')
+  expect(window.contentView.setBorderRadius).toHaveBeenLastCalledWith(24)
+  window.isFullScreen.mockReturnValue(true); window.emit('enter-full-screen')
+  expect(window.contentView.setBorderRadius).toHaveBeenLastCalledWith(0)
+  contents.emit('did-finish-load')
+  expect(contents.send).toHaveBeenLastCalledWith(LINUX_CHROME_IPC.state, { maximized: false, fullscreen: true, focused: true })
+})
