+      shadow.append(button)
+      if (action === 'maximize') { maximize = button; glyph = icon }
+    }
+    document.body.append(host)
+    if (captionStyle === 'fusion') {
+      resize = new ResizeObserver(measureCaptionRows)
+      observer = new MutationObserver(discoverCaptionRows)
+      observer.observe(document.body, { childList: true, subtree: true })
+      window.addEventListener('resize', measureCaptionRows)
