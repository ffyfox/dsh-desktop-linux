+/** Sandboxed Linux caption styles; no command or Node bridge reaches the application page. */
+import { ipcRenderer } from 'electron'
+import { WINDOWS_TITLEBAR_HEIGHT } from './windows-layout.ts'
+import { LINUX_CHROME_ARGUMENT, LINUX_CHROME_IPC, LINUX_TITLEBAR_STYLE_ARGUMENT, type LinuxChromeState } from './linux-chrome-ipc.ts'
