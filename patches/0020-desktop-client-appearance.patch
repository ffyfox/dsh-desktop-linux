+      button span { grid-area:1/1; display:grid; place-items:center; width:12px; height:12px; font:500 11px/12px sans-serif; color:#0009; opacity:0; pointer-events:none; }
+      :host(:hover) span, button:focus-visible span { opacity:1; }
