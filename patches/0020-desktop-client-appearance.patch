diff --git a/apps/desktop/renderer/client-settings.css b/apps/desktop/renderer/client-settings.css
new file mode 100644
index 00000000..e4448af3
--- /dev/null
+++ b/apps/desktop/renderer/client-settings.css
@@ -0,0 +1,102 @@
+:root {
+  color-scheme: light dark;
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
+  font-size: 13px;
+  font-synthesis: none;
+  --dsw-radius-sm: 8px;
+  --dsw-radius-md: 12px;
+  --dsw-radius-lg: 16px;
+  --dsw-radius-xl: 20px;
+  --page: #f5f5f7;
+  --surface: #ffffff;
+  --ink: #24262b;
+  --secondary: #60646e;
+  --border: #dcdfe5;
+  --control: #f0f1f4;
+  --hover: #e7e9ee;
+  --accent: #365ce6;
+  --accent-ink: #ffffff;
+  --danger: #b42435;
+  --danger-fill: #fff0f1;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --page: #1e1f23;
+    --surface: #292b30;
+    --ink: #f2f3f6;
+    --secondary: #b2b6c1;
+    --border: #41444d;
+    --control: #353840;
+    --hover: #424650;
+    --accent: #a5b7ff;
+    --accent-ink: #192345;
+    --danger: #ffb3bc;
+    --danger-fill: #422a30;
+  }
+}
+* { box-sizing: border-box; }
+body { height: 100vh; margin: 0; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: var(--page); color: var(--ink); line-height: 1.5; }
+.page-header { padding: 22px 24px 16px; }
+h1 { margin: 0; font-size: 22px; font-weight: 500; line-height: 1.3; }
+.page-header p { margin: 5px 0 0; color: var(--secondary); }
+main { min-height: 0; overflow: auto; padding: 0 24px 12px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; scrollbar-gutter: stable; }
+fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
+.group { margin-bottom: 14px; padding: 16px; border: 0.5px solid var(--border); border-radius: var(--dsw-radius-xl); background: var(--surface); }
+h2 { margin: 0 0 14px; font-size: 13px; font-weight: 500; }
+.field { margin-top: 14px; }
+h2 + .field { margin-top: 0; }
+.field-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
+.field-heading label, .field-label { font-weight: 500; }
+.number-unit { display: flex; align-items: center; gap: 5px; color: var(--secondary); }
+input, select, button, summary { font: inherit; }
+select { max-width: 55%; min-height: 32px; padding: 5px 10px; border: 0.5px solid var(--border); border-radius: var(--dsw-radius-md); color: var(--ink); background: var(--surface); }
+input[type="number"] { width: 72px; min-height: 32px; border: 0.5px solid var(--border); border-radius: var(--dsw-radius-md); padding: 5px 8px; color: var(--ink); background: var(--surface); }
+input[type="range"] { display: block; width: 100%; margin: 10px 0 6px; accent-color: var(--accent); cursor: pointer; }
+.range-labels { display: flex; justify-content: space-between; color: var(--secondary); font-size: 11px; }
+.help { display: block; margin: 5px 0 0; color: var(--secondary); font-size: 12px; font-weight: 400; line-height: 1.55; overflow-wrap: anywhere; }
+.separated { margin-top: 16px; }
+.toggle-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; cursor: pointer; }
+.field + .toggle-row, .toggle-row + .toggle-row { margin-top: 16px; padding-top: 14px; border-top: 0.5px solid var(--border); }
+.toggle-row > span { min-width: 0; }
+input[type="checkbox"] { flex: none; width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--accent); cursor: pointer; }
+.advanced summary { cursor: pointer; font-weight: 500; }
+.advanced summary + .toggle-row { margin-top: 14px; }
+.snapshot { margin-top: 16px; color: var(--secondary); font-size: 11px; }
+.restart-help { margin: 0 0 10px; font-size: 12px; color: var(--ink); }
+dl { margin: 0; }
+dl > div { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 8px; margin-top: 5px; }
+dt { font-weight: 500; color: var(--ink); }
+dd { margin: 0; overflow-wrap: anywhere; }
+.feedback { min-height: 26px; padding-top: 8px; }
+.feedback p { margin: 0; font-size: 12px; overflow-wrap: anywhere; }
+#status { color: var(--secondary); }
+#error { padding: 10px 12px; border-radius: var(--dsw-radius-md); color: var(--danger); background: var(--danger-fill); }
+#retry { margin-top: 8px; }
+footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 24px; border-top: 0.5px solid var(--border); background: var(--page); }
+.save-actions { display: flex; gap: 8px; }
+button { min-height: 36px; padding: 7px 13px; border: 0; border-radius: var(--dsw-radius-md); font-weight: 500; color: var(--ink); background: var(--control); cursor: pointer; }
+button.primary { color: var(--accent-ink); background: var(--accent); }
+button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+input[aria-invalid="true"], select[aria-invalid="true"] { outline: 2px solid var(--danger); outline-offset: 1px; }
+button:disabled, input:disabled, select:disabled { opacity: 0.5; cursor: default; }
+fieldset:disabled .toggle-row, fieldset:disabled input, fieldset:disabled select { cursor: default; }
+button[aria-busy="true"] { opacity: 1; }
+[hidden] { display: none !important; }
+@supports (corner-shape: superellipse(1.5)) {
+  .group, input[type="number"], select, button, #error { corner-shape: superellipse(1.5); }
+}
+@media (hover: hover) {
+  button:not(.primary):hover:not(:disabled) { background: var(--hover); }
+  button.primary:hover:not(:disabled) { filter: brightness(0.94); }
+}
+@media (max-width: 620px) {
+  .page-header { padding: 18px 18px 14px; }
+  main { padding-right: 18px; padding-left: 18px; }
+  footer { padding: 12px 18px; align-items: stretch; flex-wrap: wrap; }
+  .save-actions { margin-left: auto; }
+  button { padding-right: 11px; padding-left: 11px; }
+}
+@media (max-width: 440px) {
+  footer > button, .save-actions { width: 100%; }
+  .save-actions > button { flex: 1; }
+}
diff --git a/apps/desktop/renderer/client-settings.html b/apps/desktop/renderer/client-settings.html
new file mode 100644
