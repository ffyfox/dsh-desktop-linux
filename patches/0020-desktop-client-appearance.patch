+  expect((await appearance.readClientAppearance(f.root, {})).cornerRadius).toBe(5)
+})
+
+it('destroys only the settings window and removes only its own handlers on idempotent disposal', async () => {
+  const f = await fixture()
+  native.handlers.set('unrelated-shell-handler', () => true)
+  await manager!.open()
+  const get = native.handlers.get(CLIENT_SETTINGS_IPC.get)!
