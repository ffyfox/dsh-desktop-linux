+  }
+  const discoverCaptionRows = (): void => {
+    for (const row of captionRows) {
+      if (!row.isConnected) { resize?.unobserve(row); captionRows.delete(row) }
+    }
+    for (const row of document.querySelectorAll<HTMLElement>('header[data-window-drag]:has(> [data-conversation-header-leading]), [data-dockkit-strip]')) {
+      if (!captionRows.has(row)) { captionRows.add(row); resize?.observe(row) }
+    }
+    measureCaptionRows()
+  }
+  const update = (): void => {
+    document.documentElement.toggleAttribute('data-kde-glass-maximized', state.maximized)
+    document.documentElement.toggleAttribute('data-kde-glass-fullscreen', state.fullscreen)
+    if (host !== undefined) {
+      host.hidden = state.fullscreen
+      host.toggleAttribute('data-inactive', !state.focused)
+      host.toggleAttribute('data-maximized', state.maximized)
