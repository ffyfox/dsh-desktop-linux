+      const bounds = row.getBoundingClientRect()
+      row.toggleAttribute('data-dsh-caption-clearance', !state.fullscreen
+        && bounds.width > 0 && bounds.top < 48 && bounds.bottom > 0 && bounds.right >= innerWidth - 8)
