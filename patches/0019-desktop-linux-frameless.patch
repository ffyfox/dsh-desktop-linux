diff --git a/apps/desktop/tests/frameless-mode.spec.ts b/apps/desktop/tests/frameless-mode.spec.ts
new file mode 100644
index 000000000..033f02d41
--- /dev/null
+++ b/apps/desktop/tests/frameless-mode.spec.ts
@@ -0,0 +1,25 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { desktopFrameless } from '../src/frameless-mode.ts'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.unstubAllEnvs()
+})
+
+describe('desktopFrameless', () => {
+  it('accepts only the exact value 1 on linux', () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+    for (const value of [undefined, '', '0', 'true', 'yes', 'on', '2']) {
+      vi.stubEnv('DSH_DESKTOP_FRAMELESS', value)
+      expect(desktopFrameless()).toBe(false)
+    }
+    vi.stubEnv('DSH_DESKTOP_FRAMELESS', '1')
+    expect(desktopFrameless()).toBe(true)
+  })
+
+  it.each(['darwin', 'win32'] as const)('stays off on %s even with the variable set', (platform) => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue(platform)
+    vi.stubEnv('DSH_DESKTOP_FRAMELESS', '1')
+    expect(desktopFrameless()).toBe(false)
+  })
+})
