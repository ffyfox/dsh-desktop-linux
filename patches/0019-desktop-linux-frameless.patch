+/** Runtime opt-in for the Linux frameless window. */
+
+/**
+ * Whether the user requested the frameless window: Linux only, and only the exact value `1`.
+ * The frameless window supersedes glass mode, so the shell resolves both flags together.
+ * @returns true when the primary window keeps native controls without a window-manager title bar.
+ */
+export function desktopFrameless(): boolean {
+  return process.platform === 'linux' && process.env.DSH_DESKTOP_FRAMELESS === '1'
+}
